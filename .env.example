# Copy this file to `.env` for local development. Never commit real secrets.
# If you previously used the removed tracked `.env` or copied old deployment values,
# rotate DATABASE_URL, JWT_SECRET, SESSION_SECRET, WECHAT_SECRET, and
# ADMIN_CREATE_SECRET_KEY before reusing them.

NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
DATABASE_URL=<replace-with-postgres-database-url>
SESSION_SECRET=<replace-with-a-strong-random-secret>
JWT_SECRET=<replace-with-a-strong-random-secret>
WECHAT_APPID=<replace-with-wechat-app-id>
WECHAT_SECRET=<replace-with-wechat-secret>
ADMIN_CREATE_SECRET_KEY=<replace-with-a-strong-random-secret>

# Optional when running AI features locally
DEEPSEEK_API_KEY=<replace-with-deepseek-api-key>

# Optional: library docs MCP (GitHub Copilot / VS Code MCP or Cursor when launched from a shell that loads .env)
# Get a key at https://context7.com/
CONTEXT7_API_KEY=

# Optional: WeChat mini-program — comma-separated subscribe message template IDs (match / pool alerts)
TARO_APP_WECHAT_SUBSCRIBE_TMPL_IDS=

# Optional only when you intentionally need a non-default API origin.
# Leave unset for normal local development so the Vite `/api` proxy stays same-origin.
# VITE_API_URL=
CORS_ORIGINS=http://localhost:5000,http://localhost:5001
COOKIE_DOMAIN=

# ───────────────────────────────────────────────────────────────
# MCP Server Configuration (Optional — for AI assistant tooling)
# See docs/MCP_SERVERS.md for setup instructions and security notes.
# ───────────────────────────────────────────────────────────────

# GitHub MCP — Personal Access Token with repo, workflow, read:org scopes
# https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=

# Google Stitch MCP — AI UI design exploration
# Get an API key at https://stitch.withgoogle.com → Settings → Create API Key
STITCH_API_KEY=

# Figma MCP — Design context and code generation from Figma files
# Get a Personal Access Token at https://www.figma.com/developers/api#access-tokens
# See setup guide: https://developers.figma.com/docs/figma-mcp-server/
FIGMA_ACCESS_TOKEN=

# PostgreSQL MCP — read-only connection (auto-created by scripts/mcp-launchers/postgres.sh)
# Leave empty to auto-generate, or set manually for a different read-only user
MCP_DATABASE_URL=

# Grafana MCP — only needed when running the observability stack locally
# GRAFANA_URL=http://localhost:3000
# GRAFANA_API_KEY=

# JoyJoin Custom Observability MCP — admin credentials for audit-log queries
JOYJOIN_API_URL=http://localhost:5000
JOYJOIN_ADMIN_USERNAME=
JOYJOIN_ADMIN_PASSWORD=
PROBE_TIMEOUT_MS=5000

# WeChat DevTools MCP — adjust path if DevTools is installed elsewhere
# macOS (default):
WECHAT_DEVTOOLS_CLI_PATH=/Applications/wechatwebdevtools.app/Contents/MacOS/cli
# Windows (uncomment and adjust):
# WECHAT_DEVTOOLS_CLI_PATH=C:\Program Files (x86)\Tencent\微信web开发者工具\cli.bat
