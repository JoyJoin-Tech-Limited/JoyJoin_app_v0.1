# Copy this file to `.env` for local development. Never commit real secrets.
# If you previously used the removed tracked `.env` or copied old deployment values,
# rotate DATABASE_URL, JWT_SECRET, SESSION_SECRET, WECHAT_SECRET, and
# ADMIN_CREATE_SECRET_KEY before reusing them.

# APP_MODE controls the authentication strategy:
#   production — WeChat OAuth2 / Mini Program login (default)
#   test       — local phone+password login, no WeChat dependency, uses TEST_DATABASE_URL
APP_MODE=production

# Required when APP_MODE=test. Set to a separate test database (same schema, isolated data).
# TEST_DATABASE_URL=postgres://joyjoin:<password>@localhost:5432/joyjoin_test
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
DATABASE_URL=postgres://joyjoin:<password>@localhost:5432/joyjoin
# Required when APP_MODE=test:
# TEST_DATABASE_URL=postgres://joyjoin:<password>@localhost:5432/joyjoin_test
# Staging/testing only: auto-fill admin-marked test pools with virtual users when one real tester is below minGroupSize.
ENABLE_BOT_FILL_FOR_TESTING=false
# For production CVM deployment, DATABASE_URL uses the Docker service name, not localhost:
#   DATABASE_URL=postgres://joyjoin:<password>@postgres:5432/joyjoin
# POSTGRES_PASSWORD must match the password in DATABASE_URL above.
POSTGRES_PASSWORD=<replace-with-postgres-password>
SESSION_SECRET=<replace-with-a-strong-random-secret>
JWT_SECRET=<replace-with-a-strong-random-secret>
WECHAT_APPID=<replace-with-wechat-app-id>
WECHAT_SECRET=<replace-with-wechat-secret>
ADMIN_CREATE_SECRET_KEY=<replace-with-a-strong-random-secret>

# Automations — WeCom (企业微信) bot notifications
# Create a group bot in WeCom → copy the `key` query parameter from the webhook URL
#
# Three bot channels for different notification tiers:
#   WECOM_OPS_BOT_KEY       — P1/P2 daily operations (pool matching, low registration, venue onboarding)
#   WECOM_CRITICAL_BOT_KEY  — P0 urgent alerts (venue assignment failure, pool cancellation, ban actions)
#   WECOM_FINANCE_BOT_KEY   — Revenue/finance signals (first payments, refunds)
#
# Legacy single-bot fallback: WECOM_BOT_KEY is used as ops-bot key if WECOM_OPS_BOT_KEY is unset.
# WECOM_OPS_BOT_KEY=<your-wecom-ops-bot-key>
# WECOM_CRITICAL_BOT_KEY=<your-wecom-critical-bot-key>
# WECOM_FINANCE_BOT_KEY=<your-wecom-finance-bot-key>
# WECOM_BOT_KEY=<your-wecom-bot-key> (legacy fallback)
#
# Monitoring webhook secret for error-spike notifications from external monitoring.
# MONITORING_WEBHOOK_SECRET=<shared-secret>

# Optional when running AI features locally
DEEPSEEK_API_KEY=<replace-with-deepseek-api-key>

# DeepSeek V4 Model Tiers
#   ENABLE_PRO_MATCH_EXPLANATIONS — use deepseek-v4-pro (thinking) for pair explanations.
#     Default: false.  Pro is ~12x more expensive than Flash.
#   DEEPSEEK_PRO_DAILY_BUDGET_USD — daily spend cap for Pro tier calls.
#     Default: 5.00.  Router downgrades to flash-thinking when cap is hit.
ENABLE_PRO_MATCH_EXPLANATIONS=false
DEEPSEEK_PRO_DAILY_BUDGET_USD=5.00

# DeepSeek reasoning effort override for thinking-tier calls.
#   'high' (default) — standard reasoning depth. Lower latency and token usage.
#   'max'            — maximum reasoning depth. Use sparingly for tasks where
#                      first-run accuracy is critical (e.g. complex semantic
#                      analysis, high-stakes match explanations). Increases
#                      latency and token consumption significantly.
# SOCIAL_DEFAULT_REASONING_EFFORT=max

# Xiaoyue chat history window (DeepSeek V4 supports 1M context).
#   Default: 4 turns. Raise to leverage larger context (e.g. 20–50 turns).
#   With pending follow-ups the window auto-expands to the follow-up limit.
# XIAOYUE_MAX_TURNS=4
# XIAOYUE_MAX_TURNS_WITH_FOLLOWUPS=6

# ───────────────────────────────────────────────────────────────
# AI Quality Gate (LLM-as-Judge) — Optional
# ───────────────────────────────────────────────────────────────

# Enable the quality gate. Default: false.
# When true, a lightweight flash-tier judge scores generated content.
# QUALITY_GATE_ENABLED=false

# Enable BLOCKING refinement loop. Default: false.
#   true  → failed content is automatically re-generated with critique feedback
#           (adds latency; enable only after calibration)
#   false → judge runs fire-and-forget for telemetry only
# QUALITY_GATE_BLOCKING_ENABLED=false

# Sampling rate for the judge (0.0 = none, 1.0 = all). Default: 0.1
# QUALITY_GATE_SAMPLE_RATE=0.1

# Judge timeout in milliseconds. Default: 3000
# QUALITY_GATE_TIMEOUT_MS=3000

# Optional: library docs MCP (GitHub Copilot / VS Code MCP or Cursor when launched from a shell that loads .env)
# Get a key at https://context7.com/
CONTEXT7_API_KEY=

# Optional: WeChat mini-program — comma-separated subscribe message template IDs (match / pool alerts)
TARO_APP_WECHAT_SUBSCRIBE_TMPL_IDS=

# Mini-program (Taro) API origin — baked in at `apps/mini-program` build time via `config/index.ts`.
# Resolution order (see `apps/mini-program/config/apiBaseUrl.ts`): TARO_APP_API_BASE_URL → API_URL → APP_URL → http://localhost:5001
# If TARO_APP_API_BASE_URL is unset, a stale API_URL like https://api.joyjoinapp.com will still be compiled in and time out.
# Local dev: omit TARO_APP so default is localhost:5001 (see apps/mini-program/docs/TECH_STACK.md).
# Preview / production against live API: set TARO_APP explicitly. Host must match WeChat 「request 合法域名」.
# JoyJoin production API: https://api.joyjoin.com
# TARO_APP_API_BASE_URL=https://api.joyjoin.com
# Staging API (for 体验版 testing with test pricing):
# TARO_APP_API_BASE_URL=https://staging.joyjoinapp.com

# Optional only when you intentionally need a non-default API origin.
# Leave unset for normal local development so the Vite `/api` proxy stays same-origin.
# VITE_API_URL=
# CORS_ORIGINS is legacy — the server reads ALLOWED_ORIGINS.
CORS_ORIGINS=http://localhost:5000,http://localhost:5001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5000,http://localhost:5001,http://localhost:5002
COOKIE_DOMAIN=

# ───────────────────────────────────────────────────────────────
# MCP Server Configuration (Optional — for AI assistant tooling)
# See docs/MCP_SERVERS.md for setup instructions and security notes.
# ───────────────────────────────────────────────────────────────

# GitHub MCP — Personal Access Token with repo, workflow, read:org scopes
# https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=

# Google Stitch MCP — AI UI design exploration
# Get an API key at https://stitch.withgoogle.com → Settings → Create API Key
STITCH_API_KEY=

# Figma MCP — Design context and code generation from Figma files
# Get a Personal Access Token at https://www.figma.com/developers/api#access-tokens
# See setup guide: https://developers.figma.com/docs/figma-mcp-server/
FIGMA_ACCESS_TOKEN=

# PostgreSQL MCP — read-only connection (auto-created by scripts/mcp-launchers/postgres.sh)
# Leave empty to auto-generate, or set manually for a different read-only user
MCP_DATABASE_URL=

# Grafana MCP — only needed when running the observability stack locally
# GRAFANA_URL=http://localhost:3000
# GRAFANA_API_KEY=

# Self-hosted embedding endpoint (Granite or other OpenAI-compatible embedding model).
# Required if ENABLE_SEMANTIC_SIMILARITY=true. DeepSeek does not serve embedding models.
# Example: EMBEDDING_BASE_URL=http://localhost:8000/v1
# See docs/architecture/embeddings-industry-architecture.md for deployment guidance.
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=granite-embedding-97m-multilingual-r2
# EMBEDDING_TIMEOUT_MS=10000
# EMBEDDING_MAX_RETRIES=2

# Semantic matching — 7th pair-scoring dimension (6% weight)
# When true, matching uses 7 dimensions instead of 6 (semantic similarity added).
# Weights: chemistry 26 / interest 26 / socialAffinity 19 / backgroundDiversity 14 / preference 5 / language 4 / semanticSimilarity 6
# ENABLE_SEMANTIC_SIMILARITY=false

# JoyJoin Custom Observability MCP — admin credentials for audit-log queries
JOYJOIN_API_URL=http://localhost:5000
JOYJOIN_ADMIN_USERNAME=
JOYJOIN_ADMIN_PASSWORD=
PROBE_TIMEOUT_MS=5000

# WeChat DevTools MCP — adjust path if DevTools is installed elsewhere
# macOS (default):
WECHAT_DEVTOOLS_CLI_PATH=/Applications/wechatwebdevtools.app/Contents/MacOS/cli
# Windows (uncomment and adjust):
# WECHAT_DEVTOOLS_CLI_PATH=C:\Program Files (x86)\Tencent\微信web开发者工具\cli.bat

# Social Icebreaker — Xiaoyue Session Pack generation
# Set to false to disable LLM generation and always use fallback content
SOCIAL_XIAOYUE_SESSION_PACK_ENABLED=true

# Social Icebreaker — Client force-end kill-switch
# Set to true to show an "Emergency End" button to the host in active sessions.
SOCIAL_ICEBREAKER_CLIENT_FORCE_END=false
#
# Social Icebreaker — Custom mode (host-driven phase picker)
# When false, creation of and tier changes to custom mode are rejected.
# Existing preset-tier sessions are unaffected. Default: true.
SOCIAL_ICEBREAKER_CUSTOM_MODE_ENABLED=true

# Social Icebreaker — Optional phase feature flags
# All core phases are enabled by default. Disable individual phases as needed.
#
# Auction phase (virtual-coin English auction)
# Set to false to remove the auction phase from sessions.
SOCIAL_ICEBREAKER_ENABLE_AUCTION=true
#
# Personality Dice phase (roster-sized challenges)
# Default: true. Set to false to disable.
SOCIAL_ICEBREAKER_ENABLE_PERSONALITY_DICE=true
#
# Choose-Your-Prompt variant for Personality Dice
# When true, generates 3 dares per player (easy/medium/hard), player picks one.
# Default: true.
PERSONALITY_DICE_CHOOSE_MODE_ENABLED=true
#
# MiniScript (迷你剧本杀) phase
# Set to false to disable the mini_script phase in social icebreaker sessions.
SOCIAL_ICEBREAKER_ENABLE_MINI_SCRIPT=true
#
# Quip Battle phase (机智对决)
# Set to false to disable the quip_battle phase in social icebreaker sessions.
SOCIAL_ICEBREAKER_ENABLE_QUIP_BATTLE=true
#
# Undercover Word phase (谁是卧底)
# Set to false to disable the undercover_word phase in social icebreaker sessions.
SOCIAL_ICEBREAKER_ENABLE_UNDERCOVER_WORD=true
#
# Group Mirror phase (群像镜像)
# Set to false to disable the group_mirror phase in social icebreaker sessions.
SOCIAL_ICEBREAKER_ENABLE_GROUP_MIRROR=true
#
# Speed Friending phase (快速交友)
# Set to false to disable the speed_friending phase in social icebreaker sessions.
SOCIAL_ICEBREAKER_ENABLE_SPEED_FRIENDING=true
#
# Per-phase LLM kill switches. When false, the phase still runs but uses curated/deterministic
# fallback content instead of calling the model. Set to true to enable AI-generated content.
SOCIAL_WARMUP_LLM_ENABLED=true
SOCIAL_MICRO_CHALLENGE_LLM_ENABLED=true
SOCIAL_LIE_DETECTIVE_LLM_ENABLED=true
SOCIAL_AUCTION_LLM_ENABLED=true
SOCIAL_PERSONALITY_DICE_LLM_ENABLED=true
SOCIAL_GROUP_MIRROR_LLM_ENABLED=true
SOCIAL_UNDERCOVER_WORD_LLM_ENABLED=true
SOCIAL_QUIP_BATTLE_LLM_ENABLED=true
SOCIAL_MINISCRIPT_LLM_ENABLED=true
SOCIAL_RECAP_LLM_ENABLED=true
#
# LLM Game Selection — enable DeepSeek-enhanced phase ranking in compileAgentRunPlan()
# Default: false. When true, the rule engine calls LLM to rank phase suitability.
# 3s timeout with automatic fallback to deterministic rule engine baseline.
SOCIAL_ICEBREAKER_LLM_GAME_SELECTION=false
#
# Lie Detective mode — 'v1' = AI-fabricated statements (default) | 'v2' = user tags + AI fake (Spot-the-Bot)
LIE_DETECTIVE_MODE=v1

# Social Icebreaker — Tier display variant (glow tier only)
# default → 畅聊局 | tipsy → 朦胧局 | kill → 漫游局
SOCIAL_ICEBREAKER_GLOW_TIER_VARIANT=default

# Mascot display name (China market)
# Default: 悦仔. Change without deploy to rebrand or kill-switch.
MASCOT_DISPLAY_NAME=悦仔

# Mascot backstory / lore
# Set to true to include backstory in /api/auth/user response.
MASCOT_BACKSTORY_ENABLED=false

# Mascot origin lore (lineage continuity)
# Set to true to include originName (小悦) and originStory in backstory.
MASCOT_ORIGIN_LORE_ENABLED=false

# Xiaoyue connection reactions overlay in squad-unboxing / matching-status.
# Default OFF. When enabled, Xiaoyue shows animated reactions next to connection pills.
XIAOYUE_CONNECTION_REACTIONS_ENABLED=false

# MiniScript LLM generation
# Set to true to enable AI-generated script frameworks (DeepSeek/MiniMax)
# When false, uses deterministic curated stub content
SOCIAL_MINISCRIPT_LLM_ENABLED=false

# ───────────────────────────────────────────────────────────────
# Matching Algorithm — Adaptive Weights (Thompson Sampling)
# ───────────────────────────────────────────────────────────────

# Enable adaptive matching weights via Thompson Sampling bandit.
# When true, pool matching reads live weights from matching_weights_config
# instead of hardcoded defaults. The bandit updates weights based on
# post-event feedback. Default: false. Enable only after calibration.
ENABLE_ADAPTIVE_WEIGHTS=false

# Maximum percent a weight can move in a single bandit update.
# Lower = more conservative exploration. Default: 3.
# ADAPTIVE_MAX_WEIGHT_MOVEMENT_PERCENT=3
# Match Compass preference system kill-switch (set to false to hide UI and force legacy matching path)
MATCH_COMPASS_STRICTNESS_ENABLED=true

# Venue assignment kill-switch (set to false to disable auto venue assignment after pool matching)
VENUE_ASSIGNMENT_ENABLED=true

# Pool registration persona snapshot card — aggregate puzzle preview on registration first screen
# When false, the mini-program hides the PersonaSnapshotCard entirely.
PERSONA_SNAPSHOT_ENABLED=true

# Tencent Maps WebService API key (server reverse-geocoding). IP白名单 → CVM IP.
# Get a key at https://lbs.qq.com
# TENCENT_MAP_KEY=<replace-with-tencent-webservice-key>
# Tencent Maps JavaScript API key (admin portal map picker). 白名单/域名 → admin domains.
# TENCENT_MAP_JS_KEY=<replace-with-tencent-javascript-key>

# Restart onboarding feature flag — allows returning users to reset onboarding data
RESTART_ONBOARDING_ENABLED=false

# Smart Profession feature flag — AI-driven profession understanding with reveal card and auto-classification
# When false (default), ProfessionChatOverlay uses the legacy 184-keyword reaction system
SMART_PROFESSION_V1_ENABLED=true

# Admin kill-switch to show a "跳过" force-skip button on onboarding steps for stuck users
ONBOARDING_FORCE_SKIP_ENABLED=false

# AIGC label and reporting UI kill-switch.
# When false, the mini-program hides AIGC labels and AI-content reporting entry points.
# Default: false.
AIGC_LABELS_ENABLED=false
# When true, formed matching groups are held for operator approval before users are notified and venues assigned.
MATCHING_OPERATOR_REVIEW_ENABLED=false

# ───────────────────────────────────────────────────────────────
# WeChat Pay v3 — Required when PAYMENTS_ENABLED=true
# ───────────────────────────────────────────────────────────────

# Master kill-switch for the entire payment system.
# When false, payment creation endpoints return 503 PAYMENTS_DISABLED.
PAYMENTS_ENABLED=false

# Mock payment mode — when true, POST /api/payments/miniprogram/create creates
# instantly-paid orders with status=completed and mock=true instead of calling
# the WeChat Pay API. Client skips Taro.requestPayment for mock orders.
# Use for dev/staging testing without real WeChat Pay charges. Default: false.
MOCK_PAYMENTS=false

# Optional test-price override for all payment flows (event, subscription, event pack).
# When set, all real WeChat Pay charges use this amount in cents instead of the
# configured plan price. Only honored when APP_MODE is not "production".
# Example: 1 = ¥0.01, 100 = ¥1.00. Leave unset to use real prices.
# TEST_PAYMENT_PRICE_IN_CENTS=1

# WeChat Pay JSAPI / H5 payment credentials
# WECHAT_PAY_APP_ID must match WECHAT_APPID for mini-program JSAPI flow.
WECHAT_PAY_APP_ID=<replace-with-wechat-app-id-must-match-wechat-appid>
WECHAT_PAY_MCH_ID=<replace-with-merchant-id>
WECHAT_PAY_SERIAL_NO=<replace-with-certificate-serial-number>

# Private key PEM (include the -----BEGIN PRIVATE KEY----- block)
WECHAT_PAY_PRIVATE_KEY=<replace-with-apiv3-private-key-pem>

# APIv3 key — exactly 32 bytes, used for AES-256-GCM webhook decryption
WECHAT_PAY_APIV3_KEY=<replace-with-32-byte-apiv3-key>

# Platform certificate / public key PEM for webhook RSA signature verification.
# Required in staging/production. WeChat Pay now uses 微信支付公钥 (public key) mode;
# download the public key from 商户平台 → 账户中心 → API安全 → 微信支付公钥.
# Legacy platform certificate mode is also supported.
# The value may also be base64-encoded PEM (useful when the env file cannot hold multi-line values).
# In development, falls back to WECHAT_PAY_PLATFORM_PUBLIC_KEY.
WECHAT_PAY_PLATFORM_CERT=<replace-with-platform-cert-or-public-key-pem-or-base64>

# Fallback public key for webhook verification (legacy compat).
# WECHAT_PAY_PLATFORM_PUBLIC_KEY=<replace-with-platform-public-key-pem>

# Optional: override webhook notify URL. Default: APP_URL/api/webhooks/wechat-pay
# WECHAT_PAY_NOTIFY_URL=https://api.joyjoin.com/api/webhooks/wechat-pay

# Live reveal overlay kill-switch for matching status (set to false to skip overlay and go straight to group detail)
MATCHING_LIVE_REVEAL_ENABLED=true

# Matching-status puzzle-piece prelude. When true, the members stage shows an
# abstract puzzle formation instead of identity cards. Real reveal stays in
# squad-unboxing. Default: false.
MATCHING_PUZZLE_PRELUDE_ENABLED=false

# Template-driven run plan compiler for Social Icebreaker vibe reframe.
# When true, session run plans are compiled from DB templates (or code defaults)
# instead of the legacy rule engine. Kill-switch: set to false to revert.
RUN_PLAN_TEMPLATES_ENABLED=true

# Hero Promo Banner on the discover screen. Kill-switch for A/B tests
# or content audits. When false, the banner is hidden and no analytics fire.
PROMO_BANNER_ENABLED=true

# Personality share poster generation. When false, the share button is hidden
# on personality-test results. Default: true (env var fallback).
PERSONALITY_SHARE_ENABLED=true

# Personality slot-machine animation on results page. When false, results
# render immediately without the spinning reel. Default: true.
PERSONALITY_SLOT_ANIMATION_ENABLED=true

# Personality test answer-echo loading state. When false, the echo UI
# (ghost card + whisper sweep + Xiaoyue caption) is suppressed and the
# normal answer area renders immediately. Default: true.
PERSONALITY_TEST_ECHO_ENABLED=true

# Squad unboxing drag-to-reveal ribbon. When false, the drag slider is
# suppressed and users tap to reveal instead. Default: true.
SQUAD_UNBOXING_DRAG_REVEAL_ENABLED=true

# Profile tab redesign kill-switch. When false, the mini-program renders a
# simplified legacy-style Profile layout. Default: true.
PROFILE_REDESIGN_ENABLED=true

# Event pool registration kill-switch. When false, POST /api/event-pools/:id/register
# returns 503 REGISTRATION_DISABLED. Use for emergency registration freeze.
# Default: true.
REGISTRATION_ENABLED=true

# Single-test debug mode. When true, /api/test/single-test/* routes are enabled
# (icebreaker-only shortcut). Also enables virtual-user seeding at server startup.
# Never set in production.
# ENABLE_SINGLE_TEST_MODE=true

# Matching-test mode. Requires ENABLE_SINGLE_TEST_MODE=true (or APP_MODE=test).
# When enabled, /api/test/matching-test/* routes allow seeding full-profile bots
# into a test event pool, real payment, and real matching engine execution.
# Production is hard-blocked regardless of this flag (APP_MODE=production → false).
# Never set in production.
# ENABLE_MATCHING_TEST_MODE=true
