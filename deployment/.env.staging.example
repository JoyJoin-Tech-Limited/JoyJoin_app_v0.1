# JoyJoin Staging Environment
NODE_ENV=staging
PORT=5000

# Database (Staging)
DATABASE_URL=postgresql://user:password@staging-db.neon.tech/joyjoin_staging?sslmode=require

# AI Services
DEEPSEEK_API_KEY=sk-xxx

# Authentication
JWT_SECRET=staging-jwt-secret-change-me
SESSION_SECRET=staging-session-secret-change-me

# WeChat Mini Program (jscode2session — used by /api/auth/wechat/login*)
WECHAT_APPID=wx5a038ee6dee12032
WECHAT_SECRET=<your_wechat_app_secret>

# WeChat Official Account OAuth2 (web login via oauth2/authorize)
# If unset, falls back to WECHAT_APPID / WECHAT_SECRET above.
# Set these when your Official Account has a different AppID from the Mini Program.
WECHAT_OA_APPID=
WECHAT_OA_SECRET=

# Public-facing base URL of the app.
# Both the frontend and /api/* are served from this same origin via the reverse proxy,
# so a single variable is used for the WeChat OAuth2 redirect_uri and post-login redirect.
# The "网页授权域名" registered in the WeChat OA backend must match this domain.
APP_URL=https://staging-app.joyjoin.com

# CORS (Staging domains)
CORS_ORIGINS=https://staging-app.joyjoin.com,https://staging-admin.joyjoin.com

# Frontend URLs
VITE_API_URL=https://staging-api.joyjoin.com
