# JoyJoin Staging Environment
NODE_ENV=staging
APP_MODE=staging
PORT=5001

# Database (Staging)
DATABASE_URL=postgresql://joyjoin:<db-password>@postgres-staging:5432/joyjoin_staging?sslmode=disable

# Password for the postgres-staging container.
# Must match the password used in DATABASE_URL above.
POSTGRES_PASSWORD=<db-password>

# AI Services
DEEPSEEK_API_KEY=<replace-with-deepseek-api-key>

# MiniMax AI (Phase 2 hybrid social experience provider)
# MINIMAX_API_KEY=<replace-with-minimax-api-key>
# MINIMAX_BASE_URL=https://api.minimax.chat/v1
# MINIMAX_MODEL=MiniMax-Text-01

# Authentication
JWT_SECRET=<replace-with-a-strong-random-secret>
SESSION_SECRET=<replace-with-a-strong-random-secret>
ADMIN_CREATE_SECRET_KEY=<replace-with-internal-cli-secret>

# WeChat Credentials
# Used for BOTH flows:
#   ① Mini Program login (小程序): jscode2session  → /api/auth/wechat/login*
#   ② Official Account web login (公众号网页授权): oauth2/authorize → /api/auth/wechat/oauth/*
# JoyJoin's Mini Program and Official Account are bound under the same WeChat Open Platform
# account, so they share a single AppID/Secret and a unified UnionID namespace.
# No separate WECHAT_OA_APPID is needed.
WECHAT_APPID=<replace-with-wechat-app-id>
WECHAT_SECRET=<replace-with-wechat-app-secret>

# WeChat Pay (required when PAYMENTS_ENABLED=true and MOCK_PAYMENTS=false)
# WECHAT_PAY_APP_ID must equal WECHAT_APPID for mini-program JSAPI payments.
WECHAT_PAY_APP_ID=<replace-with-wechat-app-id>
WECHAT_PAY_MCH_ID=<replace-with-merchant-id>
WECHAT_PAY_SERIAL_NO=<replace-with-certificate-serial-no>
# PEM private key (-----BEGIN PRIVATE KEY-----...)
WECHAT_PAY_PRIVATE_KEY=<replace-with-private-key>
# 32-byte API v3 key
WECHAT_PAY_APIV3_KEY=<replace-with-apiv3-key>
# WeChat Pay platform certificate / public key (PEM or base64-encoded PEM) — required for
# webhook signature verification. WeChat Pay now defaults to 微信支付公钥 (public key) mode;
# download the public key from 商户平台 → 账户中心 → API安全 → 微信支付公钥, then paste the
# PEM contents here. Legacy platform certificate mode is also supported.
# If the env file cannot safely hold multi-line values, base64-encode the PEM instead.
WECHAT_PAY_PLATFORM_CERT=<replace-with-platform-cert-or-public-key-pem>

# Public-facing base URL of the app.
# /api/* is served from this same origin via the reverse proxy (path-based, NOT subdomain),
# so this single variable covers the WeChat OAuth2 redirect_uri and the post-login redirect.
# The "网页授权域名" registered in the WeChat OA backend must match this domain.
APP_URL=https://staging.joyjoinapp.com

# Staging test pricing: all real WeChat Pay charges use this amount in cents.
TEST_PAYMENT_PRICE_IN_CENTS=1

# Enable the payment system on staging.
PAYMENTS_ENABLED=true

# Mock payment mode — when true, skips real WeChat Pay and creates instantly-paid
# mock orders. Set false to charge real ¥0.01 test prices via WeChat Pay.
MOCK_PAYMENTS=false

# CORS (Staging domains)
# CORS_ORIGINS is legacy — the server reads ALLOWED_ORIGINS.
CORS_ORIGINS=https://staging-app.joyjoin.com,https://staging-admin.joyjoin.com
ALLOWED_ORIGINS=https://staging-app.joyjoin.com,https://staging-admin.joyjoin.com

# Frontend builds should keep `VITE_API_URL` unset so browser requests stay
# same-origin (`/api/*`) and rely on the edge proxy instead of browser CORS.
# VITE_API_URL=

# Template-driven run plan compiler + preset cards UX for Social Icebreaker.
RUN_PLAN_TEMPLATES_ENABLED=true

# Social Icebreaker — Optional phase feature flags (staged rollout)
# All phases enabled for staging QA.
SOCIAL_ICEBREAKER_ENABLE_AUCTION=true
SOCIAL_ICEBREAKER_ENABLE_PERSONALITY_DICE=true
PERSONALITY_DICE_CHOOSE_MODE_ENABLED=true
SOCIAL_ICEBREAKER_ENABLE_GROUP_MIRROR=true
SOCIAL_ICEBREAKER_ENABLE_UNDERCOVER_WORD=true
SOCIAL_ICEBREAKER_ENABLE_QUIP_BATTLE=true
SOCIAL_ICEBREAKER_ENABLE_SPEED_FRIENDING=true
SOCIAL_ICEBREAKER_ENABLE_MINI_SCRIPT=true
SOCIAL_ICEBREAKER_ENABLE_MOMENT_CARD_SERVER_RENDER=true

# Social Icebreaker — Per-phase LLM kill switches (all enabled in staging)
SOCIAL_WARMUP_LLM_ENABLED=true
SOCIAL_MICRO_CHALLENGE_LLM_ENABLED=true
SOCIAL_LIE_DETECTIVE_LLM_ENABLED=true
SOCIAL_AUCTION_LLM_ENABLED=true
SOCIAL_PERSONALITY_DICE_LLM_ENABLED=true
SOCIAL_GROUP_MIRROR_LLM_ENABLED=true
SOCIAL_UNDERCOVER_WORD_LLM_ENABLED=true
SOCIAL_QUIP_BATTLE_LLM_ENABLED=true
SOCIAL_MINISCRIPT_LLM_ENABLED=true
SOCIAL_RECAP_LLM_ENABLED=true

# Social Icebreaker — Tier display variant (glow tier only)
# default → 畅聊局 | tipsy → 朦胧局 | kill → 漫游局
SOCIAL_ICEBREAKER_GLOW_TIER_VARIANT=default
# Onboarding restart — welcome-back screen for returning users with partial onboarding.
# Enabled on staging for product validation.
RESTART_ONBOARDING_ENABLED=true
# Mascot display name (China market)
# Default: 悦仔. Change without deploy to rebrand or kill-switch.
MASCOT_DISPLAY_NAME=悦仔

# Mascot backstory / lore
# Set to true to include backstory in /api/auth/user response.
MASCOT_BACKSTORY_ENABLED=false

# Mascot origin lore (lineage continuity)
# Set to true to include originName (小悦) and originStory in backstory.
MASCOT_ORIGIN_LORE_ENABLED=false
# Enable single-test debug mode (单人调试局 + SingleTestBanner on staging)
ENABLE_SINGLE_TEST_MODE=true

# Internal Alang NPC prototype. Exposes entry points to every authenticated
# staging tester; single-test mode additionally unlocks debug APIs/GPS overrides.
ALANG_ENABLED=true
FLASH_SHENZHEN_LOCATION_GATE_ENABLED=true
FLASH_ANY_LOCATION_ARRIVAL_TEST_ENABLED=false

# V1.7 Profile rollout. Apply migrations 20260715010000 and
# 20260715011000 before enabling the avatar/equipment switches.
PROFILE_PIXEL_AVATAR_ENABLED=false
EQUIPMENT_REWARDS_ENABLED=false
PERSONAL_STORY_ENABLED=false
FLASH_STORY_AI_RESPONSES_ENABLED=false
# CREATIVE_AI_PERSONAL_STORY_PROVIDER=minimax

# Enable matching-test mode (end-to-end payment + matching with bots).
# Requires ENABLE_SINGLE_TEST_MODE=true. Provides /api/test/matching-test/* routes.
ENABLE_MATCHING_TEST_MODE=true

# Enable Social Icebreaker bot simulation for single-test 调试局 sessions.
# Requires ENABLE_SINGLE_TEST_MODE=true. When unset, 调试局 sessions show only
# the warmup topic cards and skip straight to recap (bots never join), because
# every other phase requires ≥2 participants.
SOCIAL_ICEBREAKER_TEST_MODE_ENABLED=true

# Enable 双人成行 (duo registration) kill-switch. Default: true.
DUO_REGISTRATION_ENABLED=true

# Venue assignment kill-switch
VENUE_ASSIGNMENT_ENABLED=true
