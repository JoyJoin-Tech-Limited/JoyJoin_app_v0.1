# JoyJoin Staging Environment
NODE_ENV=staging
PORT=5000

# Database (Staging)
DATABASE_URL=postgresql://user:password@staging-db.neon.tech/joyjoin_staging?sslmode=require

# AI Services
DEEPSEEK_API_KEY=sk-xxx

# MiniMax AI (Social Icebreaker hybrid provider)
# When set, generateWarmupTopics / generateXiaoYueComment / generateRecapSummary /
# generateLieDetectiveStatements will use MiniMax instead of DeepSeek.
# If unset, all Social Icebreaker functions fall back to DeepSeek automatically.
MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# MINIMAX_MODEL=MiniMax-Text-01
SOCIAL_AI_PROVIDER=hybrid

# Authentication
JWT_SECRET=staging-jwt-secret-change-me
SESSION_SECRET=staging-session-secret-change-me

# WeChat Credentials
# Used for BOTH flows:
#   ① Mini Program login (小程序): jscode2session  → /api/auth/wechat/login*
#   ② Official Account web login (公众号网页授权): oauth2/authorize → /api/auth/wechat/oauth/*
# JoyJoin's Mini Program and Official Account are bound under the same WeChat Open Platform
# account, so they share a single AppID/Secret and a unified UnionID namespace.
# No separate WECHAT_OA_APPID is needed.
WECHAT_APPID=wx5a038ee6dee12032
WECHAT_SECRET=<your_wechat_app_secret>

# Public-facing base URL of the app.
# /api/* is served from this same origin via the reverse proxy (path-based, NOT subdomain),
# so this single variable covers the WeChat OAuth2 redirect_uri and the post-login redirect.
# The "网页授权域名" registered in the WeChat OA backend must match this domain.
APP_URL=https://staging-app.joyjoin.com

# CORS (Staging domains)
CORS_ORIGINS=https://staging-app.joyjoin.com,https://staging-admin.joyjoin.com

# Frontend URLs
VITE_API_URL=https://staging-api.joyjoin.com
