# JoyJoin Production Environment (joyjoinapp.com)
NODE_ENV=production
PORT=5000
FLASH_SHENZHEN_LOCATION_GATE_ENABLED=true

# Database (Production)
DATABASE_URL=postgresql://<db-user>:<db-password>@<prod-db-host>/<db-name>?sslmode=require

# AI Services
DEEPSEEK_API_KEY=<replace-with-deepseek-api-key>

# MiniMax AI (Phase 3 hybrid routing: tag/theme/title generation)
# If set, MiniMax is used for creative/identity-facing generation surfaces.
# Leave unset to continue using DeepSeek for all AI services.
# MINIMAX_API_KEY=<replace-with-minimax-api-key>
# MINIMAX_BASE_URL=https://api.minimax.chat/v1   # optional override
# MINIMAX_MODEL=abab6.5s-chat                     # optional model override
# MINIMAX_TIMEOUT_MS=15000                        # optional timeout override (default: 15000ms)

# Creative AI provider routing (Phase 3 services)
# Valid values: minimax | deepseek  (default: minimax if MINIMAX_API_KEY is set, otherwise deepseek)
# CREATIVE_AI_PROVIDER=minimax
# CREATIVE_AI_TAGS_PROVIDER=minimax    # override for tagGenerationService
# CREATIVE_AI_THEME_PROVIDER=minimax   # override for themeLLMService
# CREATIVE_AI_TITLE_PROVIDER=minimax   # override for eventThemeTitleGenerator
# CREATIVE_AI_PERSONAL_STORY_PROVIDER=minimax  # MiniMax primary, DeepSeek fallback

# V1.7 Profile capabilities remain fail-closed until their migrations, assets,
# and staged smoke checks are complete.
PROFILE_PIXEL_AVATAR_ENABLED=false
EQUIPMENT_REWARDS_ENABLED=false
PERSONAL_STORY_ENABLED=false
# AI_TIMEOUT_MS=5000                   # global title-gen timeout override (also accepts DEEPSEEK_TIMEOUT_MS/MINIMAX_TIMEOUT_MS)

# Authentication & Session
JWT_SECRET=<replace-with-a-strong-random-secret>
SESSION_SECRET=<replace-with-a-strong-random-secret>
ADMIN_CREATE_SECRET_KEY=<replace-with-internal-cli-secret>

# WeChat Credentials
# Used for BOTH flows:
#   ① Mini Program login (小程序): jscode2session  → /api/auth/wechat/login*
#   ② Official Account web login (公众号网页授权): oauth2/authorize → /api/auth/wechat/oauth/*
# JoyJoin's Mini Program and Official Account are bound under the same WeChat Open Platform
# account, so they share a single AppID/Secret and a unified UnionID namespace.
# No separate WECHAT_OA_APPID is needed.
WECHAT_APPID=<replace-with-wechat-app-id>
WECHAT_SECRET=<replace-with-wechat-app-secret>

# Public-facing base URL of the app.
# /api/* is served from this same origin via the Nginx reverse proxy (path-based, NOT subdomain)
# managed by deployment/nginx/joyjoin.conf. This single variable
# covers the WeChat OAuth2 redirect_uri AND the post-login redirect target.
# The "网页授权域名" registered in the WeChat OA backend must match this domain.
APP_URL=https://joyjoinapp.com

# Cross-subdomain cookie sharing (注意前面的点号)
# 允许两个域名的所有子域名共享登录状态
COOKIE_DOMAIN=.joyjoinapp.com

# CORS (Production domains)
# CORS_ORIGINS is legacy — the server reads ALLOWED_ORIGINS.
CORS_ORIGINS=https://joyjoinapp.com,https://www.joyjoinapp.com,https://admin.joyjoinapp.com,https://api.joyjoinapp.com
ALLOWED_ORIGINS=https://joyjoinapp.com,https://www.joyjoinapp.com,https://admin.joyjoinapp.com,https://api.joyjoinapp.com

# Frontend builds should keep `VITE_API_URL` unset in production so browser
# requests stay same-origin (`/api/*`) and use the host Nginx reverse proxy.
# VITE_API_URL=

# Social Icebreaker — Optional phase feature flags
# All core phases are enabled by default. Disable individual phases as needed.
# Auction phase (virtual-coin English auction)
SOCIAL_ICEBREAKER_ENABLE_AUCTION=true
# Personality Dice phase (roster-sized challenges)
SOCIAL_ICEBREAKER_ENABLE_PERSONALITY_DICE=true
# Group Mirror phase (群像镜像)
SOCIAL_ICEBREAKER_ENABLE_GROUP_MIRROR=true
# Undercover Word phase (谁是卧底)
SOCIAL_ICEBREAKER_ENABLE_UNDERCOVER_WORD=true
# Quip Battle phase (机智对决)
SOCIAL_ICEBREAKER_ENABLE_QUIP_BATTLE=true
# Speed Friending phase (快速交友)
SOCIAL_ICEBREAKER_ENABLE_SPEED_FRIENDING=true
# MiniScript (迷你剧本杀) phase
SOCIAL_ICEBREAKER_ENABLE_MINI_SCRIPT=true
# MiniScript LLM generation
SOCIAL_MINISCRIPT_LLM_ENABLED=true

# Social Icebreaker — Per-phase LLM kill switches
# Set to false to use curated/deterministic fallback content instead of AI generation.
SOCIAL_WARMUP_LLM_ENABLED=true
SOCIAL_MICRO_CHALLENGE_LLM_ENABLED=true
SOCIAL_LIE_DETECTIVE_LLM_ENABLED=true
SOCIAL_AUCTION_LLM_ENABLED=true
SOCIAL_PERSONALITY_DICE_LLM_ENABLED=true
SOCIAL_GROUP_MIRROR_LLM_ENABLED=true
SOCIAL_UNDERCOVER_WORD_LLM_ENABLED=true
SOCIAL_QUIP_BATTLE_LLM_ENABLED=true
SOCIAL_RECAP_LLM_ENABLED=true

# Template-driven run plan compiler for Social Icebreaker vibe reframe.
# When true, the client shows the human-intention preset cards + vibe selector.
RUN_PLAN_TEMPLATES_ENABLED=true

# Social Icebreaker — Tier display variant (glow tier only)
# default → 畅聊局 | tipsy → 朦胧局 | kill → 漫游局
SOCIAL_ICEBREAKER_GLOW_TIER_VARIANT=default
# Onboarding restart — welcome-back screen for returning users with partial onboarding.
# Off by default until product validation.
RESTART_ONBOARDING_ENABLED=false
# Mascot display name (China market)
# Default: 悦仔. Change without deploy to rebrand or kill-switch.
MASCOT_DISPLAY_NAME=悦仔

# Mascot backstory / lore
# Set to true to include backstory in /api/auth/user response.
MASCOT_BACKSTORY_ENABLED=false

# Mascot origin lore (lineage continuity)
# Set to true to include originName (小悦) and originStory in backstory.
MASCOT_ORIGIN_LORE_ENABLED=false
\n# Venue assignment kill-switch\nVENUE_ASSIGNMENT_ENABLED=true
