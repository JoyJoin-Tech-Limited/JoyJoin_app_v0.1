{
  "name": "joyjoin-monorepo",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run db:push && npm run dev:server",
    "build": "npm run dep-check && npm run build:admin && npm run build:server",
    "typecheck": "npm run typecheck -w @joyjoin/shared && npm run typecheck -w @joyjoin/admin-client && npm run typecheck -w mini-program && npm run typecheck -w @joyjoin/server",
    "check": "npm run typecheck",
    "check:clients": "npm run typecheck -w @joyjoin/shared && npm run typecheck -w @joyjoin/admin-client && npm run typecheck -w mini-program",
    "check:server": "npm run typecheck -w @joyjoin/server",
    "check:full": "npm run guardrails && npm run lint && npm run test && npm run build",
    "lint": "npm run lint -w @joyjoin/shared && npm run lint -w @joyjoin/admin-client && npm run lint -w @joyjoin/server",
    "test": "npm run test -w @joyjoin/shared && npm run test -w @joyjoin/admin-client && npm run test -w @joyjoin/server",
    "test:e2e": "npm run test:e2e -w @joyjoin/e2e",
    "test:e2e:ui": "npm run test:e2e:ui -w @joyjoin/e2e",
    "dev:admin": "npm run dev -w @joyjoin/admin-client",
    "dev:server": "npm run dev -w @joyjoin/server",
    "dev:all": "npm run dev",
    "build:admin": "npm run build -w @joyjoin/admin-client",
    "build:server": "npm run build -w @joyjoin/server",
    "start": "npm run db:migrate && npm run start -w @joyjoin/server",
    "guardrails": "node scripts/check/check-guardrails.mjs && node --test scripts/check/check-guardrails.test.mjs && node scripts/check/check-brand-colors.mjs && node scripts/devtools/design-audit.mjs && node scripts/check/check-doc-mapping.mjs",
    "bundle-size:check": "node scripts/check/check-bundle-size.mjs",
    "design:audit": "node scripts/devtools/design-audit.mjs",
    "audit:visual": "node scripts/visual-correctness-scan.mjs",
    "dep-check": "node scripts/check/check-workspace-dependency-ownership.mjs",
    "setup:agent-skills": "node scripts/setup-agent-skills.mjs",
    "postinstall": "node -e \"const fs = require('fs'); const cp = require('child_process'); if (fs.existsSync('scripts/setup-agent-skills.mjs')) { const result = cp.spawnSync('npm', ['run', 'setup:agent-skills'], { stdio: 'inherit', shell: true }); process.exit(result.status || 0); }\"",
    "doc-mapping:check": "node scripts/check/check-doc-mapping.mjs",
    "memory:validate": "node scripts/memory/memory-validate.mjs",
    "memory:draft-candidate": "node scripts/memory/memory-draft-candidate.mjs",
    "memory:auto-land": "node scripts/memory/memory-auto-land.mjs",
    "memory:build-index": "node scripts/memory/memory-build-index.mjs",
    "memory:query": "node scripts/memory/memory-query.mjs",
    "memory:stage-candidate": "node scripts/memory/memory-stage-candidate.mjs",
    "memory:promote": "node scripts/memory/memory-promote.mjs",
    "orchestration:validate": "node scripts/orchestration/orchestration-supervisor.mjs validate",
    "orchestration:test": "node scripts/orchestration/orchestration-turn-summary.test.mjs",
    "orchestration:hook": "node scripts/orchestration/orchestration-supervisor.mjs copilot-hook",
    "orchestration:git-hook": "node scripts/orchestration/orchestration-supervisor.mjs git-hook",
    "orchestration:workflow": "node scripts/orchestration/orchestration-supervisor.mjs workflow",
    "orchestration:tooling-report": "node scripts/orchestration/orchestration-supervisor.mjs tooling-report",
    "harness:gate": "node scripts/harness/harness-completion-gate.mjs",
    "harness:gate:json": "node scripts/harness/harness-completion-gate.mjs --json",
    "harness:gate:strict": "node scripts/harness/harness-completion-gate.mjs --fail-on-concern",
    "db:push": "drizzle-kit push --config=apps/server/drizzle.config.cjs",
    "db:migrate": "npm run db:migrate -w @joyjoin/server",
    "db:verify": "node --env-file=.env scripts/verify/verify-db-alignment.mjs",
    "db:journal-check": "node scripts/verify/verify-journal-sync.mjs",
    "db:rebuild-journal": "node scripts/rebuild-journal.mjs",
    "db:status": "npm run db:journal-check && npm run db:verify",
    "set-admin": "npm run admin:create",
    "admin:create": "npm run admin:create -w @joyjoin/server",
    "auto:debug": "node scripts/auto/auto-debug.mjs",
    "auto:debug:pr": "node scripts/auto/auto-debug.mjs --pr --wecom --verbose",
    "auto:debug:full": "node scripts/auto/auto-debug.mjs --commits 50 --pr --wecom --verbose",
    "auto:docs": "node scripts/auto/auto-docs.mjs",
    "auto:docs:pr": "node scripts/auto/auto-docs.mjs --pr --wecom --checklist --verbose",
    "auto:docs:full": "node scripts/auto/auto-docs.mjs --scan-all --pr --wecom --checklist --verbose",
    "auto:digest": "node scripts/auto/auto-digest.mjs",
    "auto:digest:wecom": "node scripts/auto/auto-digest.mjs --wecom --verbose",
    "auto:test": "node scripts/auto/auto-test.mjs",
    "auto:test:pr": "node scripts/auto/auto-test.mjs --pr --wecom --verbose",
    "auto:ci-fix": "node scripts/auto/auto-ci-fix.mjs",
    "auto:ci-fix:pr": "node scripts/auto/auto-ci-fix.mjs --pr --wecom --verbose",
    "auto:prune": "node scripts/auto/auto-prune.mjs",
    "auto:prune:live": "node scripts/auto/auto-prune.mjs --live",
    "auto:prune:wecom": "node scripts/auto/auto-prune.mjs --live --wecom",
    "auto:triage": "node scripts/auto/auto-triage.mjs",
    "auto:triage:dry": "node scripts/auto/auto-triage.mjs --dry-run",
    "auto:triage:wecom": "node scripts/auto/auto-triage.mjs --wecom",
    "auto:merge": "node scripts/auto/auto-merge.mjs",
    "auto:merge:live": "node scripts/auto/auto-merge.mjs --live",
    "auto:merge:wecom": "node scripts/auto/auto-merge.mjs --live --wecom",
    "auto:fix": "node scripts/auto/auto-fix.mjs",
    "auto:fix:pr": "node scripts/auto/auto-fix.mjs --pr --wecom --verbose",
    "auto:fix:full": "node scripts/auto/auto-fix.mjs --commits 30 --pr --wecom --verbose",
    "auto:list": "node -e \"const s=require('fs').readFileSync('package.json','utf8');const p=JSON.parse(s);Object.keys(p.scripts||{}).filter(k=>k.startsWith('auto:')||k==='wecom:notify').forEach(k=>console.log('  '+k+' → '+p.scripts[k]))\"",
    "user:create": "npm run user:create -w @joyjoin/server",
    "user:bypass": "npm run user:bypass -w @joyjoin/server",
    "seed:test-data": "npm run seed:test-data -w @joyjoin/server",
    "seed:mock-data": "npm run seed:mock-data -w @joyjoin/server",
    "wecom:notify": "node scripts/wecom-notify.mjs",
    "simulate:personas:generate": "tsx scripts/simulate/generate-boundary-personas.ts",
    "simulate:personas:run": "tsx scripts/simulate/run-persona-suite.ts --personas=boundaries --noise=clean",
    "simulate:personas:run:all": "tsx scripts/simulate/run-persona-suite.ts --personas=all --noise=clean",
    "simulate:personas:run:ci": "tsx scripts/simulate/run-persona-suite.ts --personas=centroids --noise=clean --isolation-only",
    "simulate:personas:retest": "tsx scripts/simulate/run-test-retest.ts --n=5 --personas=all",
    "simulate:expert-packet": "tsx scripts/simulate/generate-expert-packet.ts",
    "simulate:full": "npm run simulate:personas:generate && npm run simulate:personas:run:all && npm run simulate:personas:retest",
    "simulate:gate": "npm run simulate:personas:generate && npm run simulate:personas:run:ci",
    "screenshot:events": "node scripts/screenshot-open.mjs events",
    "screenshot:tier-selector": "node scripts/screenshot-open.mjs tier-selector",
    "screenshot:pool-registration": "node scripts/screenshot-open.mjs pool-registration",
    "screenshot:event-ticket-payment": "node scripts/screenshot-open.mjs event-ticket-payment",
    "screenshot:squad-unboxing": "node scripts/screenshot-open.mjs squad-unboxing",
    "screenshot:profile-review": "node scripts/screenshot-open.mjs profile-review",
    "screenshot:help": "node scripts/screenshot-open.mjs --help"
  }
}
