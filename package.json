{
  "name": "joyjoin-monorepo",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run db:push && npm run dev:server",
    "build": "npm run dep-check && npm run build:admin && npm run build:server",
    "typecheck": "npm run typecheck -w @joyjoin/shared && npm run typecheck -w @joyjoin/admin-client && npm run typecheck -w mini-program && npm run typecheck -w @joyjoin/server",
    "check": "npm run typecheck",
    "check:clients": "npm run typecheck -w @joyjoin/shared && npm run typecheck -w @joyjoin/admin-client && npm run typecheck -w mini-program",
    "check:server": "npm run typecheck -w @joyjoin/server",
    "check:full": "npm run guardrails && npm run lint && npm run test && npm run build",
    "lint": "npm run lint -w @joyjoin/shared && npm run lint -w @joyjoin/admin-client && npm run lint -w @joyjoin/server",
    "test": "npm run test -w @joyjoin/shared && npm run test -w @joyjoin/admin-client && npm run test -w @joyjoin/server",
    "test:e2e": "npm run test:e2e -w @joyjoin/e2e",
    "test:e2e:ui": "npm run test:e2e:ui -w @joyjoin/e2e",
    "dev:user": "npm run dev -w @joyjoin/user-client",
    "dev:admin": "npm run dev -w @joyjoin/admin-client",
    "dev:server": "npm run dev -w @joyjoin/server",
    "dev:all": "npm run dev",
    "build:user": "npm run build -w @joyjoin/user-client",
    "build:admin": "npm run build -w @joyjoin/admin-client",
    "build:server": "npm run build -w @joyjoin/server",
    "start": "npm run db:migrate && npm run start -w @joyjoin/server",
    "guardrails": "node scripts/check-guardrails.mjs && node --test scripts/check-guardrails.test.mjs && node scripts/check-brand-colors.mjs && node scripts/design-audit.mjs && node scripts/check-doc-mapping.mjs",
    "bundle-size:check": "node scripts/check-bundle-size.mjs",
    "design:audit": "node scripts/design-audit.mjs",
    "dep-check": "node scripts/check-workspace-dependency-ownership.mjs",
    "doc-mapping:check": "node scripts/check-doc-mapping.mjs",
    "memory:validate": "node scripts/memory-validate.mjs",
    "memory:draft-candidate": "node scripts/memory-draft-candidate.mjs",
    "memory:auto-land": "node scripts/memory-auto-land.mjs",
    "memory:build-index": "node scripts/memory-build-index.mjs",
    "memory:query": "node scripts/memory-query.mjs",
    "memory:stage-candidate": "node scripts/memory-stage-candidate.mjs",
    "memory:promote": "node scripts/memory-promote.mjs",
    "orchestration:validate": "node scripts/orchestration-supervisor.mjs validate",
    "orchestration:test": "node scripts/orchestration-turn-summary.test.mjs",
    "orchestration:hook": "node scripts/orchestration-supervisor.mjs copilot-hook",
    "orchestration:git-hook": "node scripts/orchestration-supervisor.mjs git-hook",
    "orchestration:workflow": "node scripts/orchestration-supervisor.mjs workflow",
    "orchestration:tooling-report": "node scripts/orchestration-supervisor.mjs tooling-report",
    "harness:gate": "node scripts/harness-completion-gate.mjs",
    "harness:gate:json": "node scripts/harness-completion-gate.mjs --json",
    "harness:gate:strict": "node scripts/harness-completion-gate.mjs --fail-on-concern",
    "db:push": "drizzle-kit push --config=apps/server/drizzle.config.cjs",
    "db:migrate": "npm run db:migrate -w @joyjoin/server",
    "db:verify": "node --env-file=.env scripts/verify-db-alignment.mjs",
    "db:journal-check": "node scripts/verify-journal-sync.mjs",
    "db:rebuild-journal": "node scripts/rebuild-journal.mjs",
    "db:status": "npm run db:journal-check && npm run db:verify",
    "set-admin": "npm run admin:create",
    "admin:create": "npm run admin:create -w @joyjoin/server",
    "auto:debug": "node scripts/auto-debug.mjs",
    "auto:debug:pr": "node scripts/auto-debug.mjs --pr --wecom --verbose",
    "auto:debug:full": "node scripts/auto-debug.mjs --commits 50 --pr --wecom --verbose",
    "auto:docs": "node scripts/auto-docs.mjs",
    "auto:docs:pr": "node scripts/auto-docs.mjs --pr --wecom --checklist --verbose",
    "auto:docs:full": "node scripts/auto-docs.mjs --scan-all --pr --wecom --checklist --verbose",
    "auto:digest": "node scripts/auto-digest.mjs",
    "auto:digest:wecom": "node scripts/auto-digest.mjs --wecom --verbose",
    "auto:test": "node scripts/auto-test.mjs",
    "auto:test:pr": "node scripts/auto-test.mjs --pr --wecom --verbose",
    "auto:ci-fix": "node scripts/auto-ci-fix.mjs",
    "auto:ci-fix:pr": "node scripts/auto-ci-fix.mjs --pr --wecom --verbose",
    "auto:prune": "node scripts/auto-prune.mjs",
    "auto:prune:live": "node scripts/auto-prune.mjs --live",
    "auto:prune:wecom": "node scripts/auto-prune.mjs --live --wecom",
    "auto:triage": "node scripts/auto-triage.mjs",
    "auto:triage:dry": "node scripts/auto-triage.mjs --dry-run",
    "auto:triage:wecom": "node scripts/auto-triage.mjs --wecom",
    "auto:merge": "node scripts/auto-merge.mjs",
    "auto:merge:live": "node scripts/auto-merge.mjs --live",
    "auto:merge:wecom": "node scripts/auto-merge.mjs --live --wecom",
    "auto:fix": "node scripts/auto-fix.mjs",
    "auto:fix:pr": "node scripts/auto-fix.mjs --pr --wecom --verbose",
    "auto:fix:full": "node scripts/auto-fix.mjs --commits 30 --pr --wecom --verbose",
    "auto:list": "node -e \"const s=require('fs').readFileSync('package.json','utf8');const p=JSON.parse(s);Object.keys(p.scripts||{}).filter(k=>k.startsWith('auto:')||k==='wecom:notify').forEach(k=>console.log('  '+k+' → '+p.scripts[k]))\"",
    "user:create": "npm run user:create -w @joyjoin/server",
    "user:bypass": "npm run user:bypass -w @joyjoin/server",
    "seed:test-data": "npm run seed:test-data -w @joyjoin/server",
    "wecom:notify": "node scripts/wecom-notify.mjs"
  }
}
