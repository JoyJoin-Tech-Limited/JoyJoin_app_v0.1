{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "JoyJoin Server — HTTP metrics, latency, errors, and process resources",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Request Traffic",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2 }, "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"joyjoin_server\"}[1m]))",
          "legendFormat": "Total req/s",
          "refId": "A"
        }
      ],
      "title": "Request Rate (req/s)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2 }, "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(http_errors_total{job=\"joyjoin_server\", status_code=~\"5..\"}[1m]))",
          "legendFormat": "5xx / s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_errors_total{job=\"joyjoin_server\", status_code=~\"4..\"}[1m]))",
          "legendFormat": "4xx / s",
          "refId": "B"
        }
      ],
      "title": "Error Rate by Status Class",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Latency",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 10 },
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_ms_bucket{job=\"joyjoin_server\"}[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_ms_bucket{job=\"joyjoin_server\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_ms_bucket{job=\"joyjoin_server\"}[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "Request Latency Percentiles (ms)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "title": "Process Resources",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 4,
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"joyjoin_server\"}",
          "legendFormat": "RSS",
          "refId": "A"
        },
        {
          "expr": "process_heap_used_bytes{job=\"joyjoin_server\"}",
          "legendFormat": "Heap Used",
          "refId": "B"
        },
        {
          "expr": "process_heap_total_bytes{job=\"joyjoin_server\"}",
          "legendFormat": "Heap Total",
          "refId": "C"
        }
      ],
      "title": "Memory Usage",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 5,
      "targets": [
        {
          "expr": "rate(process_cpu_user_seconds_total{job=\"joyjoin_server\"}[1m])",
          "legendFormat": "CPU User",
          "refId": "A"
        },
        {
          "expr": "rate(process_cpu_system_seconds_total{job=\"joyjoin_server\"}[1m])",
          "legendFormat": "CPU System",
          "refId": "B"
        }
      ],
      "title": "CPU Utilisation",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 27 },
      "id": 6,
      "targets": [
        {
          "expr": "nodejs_event_loop_delay_ms{job=\"joyjoin_server\"}",
          "legendFormat": "Event Loop Delay",
          "refId": "A"
        }
      ],
      "title": "Node.js Event Loop Delay (ms)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "id": 103,
      "title": "Error Logs (Loki)",
      "type": "row"
    },
    {
      "datasource": "Loki",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 33 },
      "id": 7,
      "options": {
        "dedupStrategy": "none",
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{service=\"joyjoin-server\"} | json | level=~\"error|warn\"",
          "refId": "A"
        }
      ],
      "title": "Error & Warning Logs",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["joyjoin", "backend", "api"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "JoyJoin Server Overview",
  "uid": "joyjoin-server-overview",
  "version": 1
}
