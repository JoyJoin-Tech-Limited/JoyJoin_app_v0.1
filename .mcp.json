{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "hermes": {
      "command": "hermes",
      "args": ["mcp", "serve"]
    },
    "agentMemory": {
      "command": "npx",
      "args": ["-y", "@adamrdrew/agent-memory-mcp"],
      "env": {
        "MEMORY_DB_PATH": ".joyjoin/agent-memory-db"
      }
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@executeautomation/playwright-mcp-server"]
    },
    "observability": {
      "command": "node",
      "args": ["packages/e2e/mcp-servers/observability.mjs"]
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "${MCP_DATABASE_URL}"],
      "env": {}
    },
    "wechat-devtools": {
      "command": "npx",
      "args": ["-y", "wechat-dev-mcp"],
      "env": {
        "WECHAT_DEVTOOLS_CLI_PATH": "/Applications/wechatwebdevtools.app/Contents/MacOS/cli"
      }
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "${PWD}"],
      "env": {}
    },
    "stitch": {
      "command": "npx",
      "args": ["-y", "@_davideast/stitch-mcp", "proxy"],
      "env": {
        "STITCH_API_KEY": "${STITCH_API_KEY}"
      }
    },
    "figma": {
      "command": "npx",
      "args": ["-y", "@figma/mcp"],
      "env": {
        "FIGMA_ACCESS_TOKEN": "${FIGMA_ACCESS_TOKEN}"
      }
    },
    "dnspod": {
      "command": "uvx",
      "args": ["mcp-server-dnspod"],
      "env": {
        "TENCENTCLOUD_SECRET_ID": "${TENCENTCLOUD_SECRET_ID}",
        "TENCENTCLOUD_SECRET_KEY": "${TENCENTCLOUD_SECRET_KEY}"
      }
    }
  }
}
