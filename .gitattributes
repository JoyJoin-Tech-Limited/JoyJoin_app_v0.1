* text=auto eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff2 binary
*.woff binary
*.ttf binary
*.otf binary
*.eot binary
*.zip binary
*.gz binary
*.tar binary
*.mp4 binary
*.mp3 binary

# Generated / lock files
*.lock text eol=lf
package-lock.json text eol=lf
pnpm-lock.yaml text eol=lf
yarn.lock text eol=lf

# Shell scripts must be LF
*.sh text eol=lf

# Batch scripts can be CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
