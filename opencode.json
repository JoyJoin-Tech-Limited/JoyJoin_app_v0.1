{
  "$schema": "https://opencode.ai/config.json",
  "model": "kimi-coding/k3",
  "provider": {
    "deepseek": {
      "models": {
        "deepseek-v4-flash": {
          "options": {
            "maxTokens": 16384
          },
          "variants": {
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "deepseek-v4-pro": {
          "options": {
            "maxTokens": 16384
          },
          "variants": {
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        }
      }
    },
    "kimi-coding": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kimi For Coding",
      "options": {
        "baseURL": "https://api.kimi.com/coding/v1"
      },
      "models": {
        "kimi-for-coding": {
          "name": "Kimi K2.8 Preview",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": false,
          "interleaved": { "field": "reasoning_content" },
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "modalities": {
            "input": ["text", "image", "video"],
            "output": ["text"]
          },
          "options": {
            "maxTokens": 131072
          },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" }
          }
        },
        "k3": {
          "name": "Kimi K3",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": false,
          "interleaved": { "field": "reasoning_content" },
          "limit": {
            "context": 1048576,
            "output": 131072
          },
          "modalities": {
            "input": ["text", "image", "video"],
            "output": ["text"]
          },
          "options": {
            "maxTokens": 131072
          },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" }
          }
        },
        "k3-256k": {
          "name": "Kimi K3-256K",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": false,
          "interleaved": { "field": "reasoning_content" },
          "limit": {
            "context": 262144,
            "output": 131072
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "options": {
            "maxTokens": 131072
          },
          "variants": {
            "low": { "reasoningEffort": "low" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "max" }
          }
        },
        "kimi-for-coding-highspeed": {
          "name": "Kimi K2.7 Code HighSpeed",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": false,
          "interleaved": { "field": "reasoning_content" },
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "modalities": {
            "input": ["text", "image", "video"],
            "output": ["text"]
          },
          "options": {
            "maxTokens": 32768
          }
        },
        "kimi-k2.6": {
          "name": "Kimi K2.6",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "temperature": false,
          "interleaved": { "field": "reasoning_content" },
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "modalities": {
            "input": ["text", "image", "video"],
            "output": ["text"]
          },
          "options": {
            "maxTokens": 32768
          },
          "variants": {
            "thinking": { "thinking": true }
          }
        }
      }
    },
    "kimi-code-plan-cn": {
      "blacklist": ["k3", "k3-256k", "kimi-for-coding", "kimi-for-coding-highspeed", "kimi-k2.6"]
    },
    "glm": {
      "models": {
        "glm-5.1-fp8": {
          "options": {
            "maxTokens": 16384
          }
        },
        "glm-5-fp8": {
          "options": {
            "maxTokens": 16384
          }
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "postgres": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres"
      ],
      "args": [
        "{env:MCP_DATABASE_URL}"
      ]
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem"
      ],
      "args": [
        "{env:PWD}"
      ]
    },
    "agentMemory": {
      "type": "local",
      "command": [
        "/Users/vincentlai/.npm-global/bin/agent-memory-mcp"
      ],
      "environment": {
        "MEMORY_DB_PATH": "/Users/vincentlai/GitHub/JoyJoin_app_v0.1/.joyjoin/agent-memory-db"
      }
    }
  },
  "permission": {
    "*": "allow",
    "task": {
      "*": "allow"
    },
    "skill": {
      "*": "allow"
    }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "opencode-mem"
  ],
  "command": {
    "mentor": {
      "template": "Load the cto-mentor skill. Provide a structured mentor breakdown of the most recent implementation work: (1) What we did & why — high-level friendly summary, (2) Key ideas at play — 2-3 concepts with plain-language metaphors first, (3) Trade-offs we made — honest about what we gave up, (4) Where to go next — concrete study/practice/build suggestions. Tone: warm, encouraging, jargon-free. Max 3 concepts.",
      "description": "CTO Mentor — structured breakdown of completed work"
    }
  },
  "instructions": [
    ".opencode/rules/joyjoin-workflow.md",
    ".opencode/rules/joyjoin-orchestration.md",
    ".opencode/rules/joyjoin-harness.md"
  ],
  "agent": {
    "build": {
      "permission": {
        "task": {
          "*": "allow"
        },
        "skill": {
          "*": "allow"
        },
        "bash": {
          "*": "allow"
        },
        "edit": "allow",
        "webfetch": "allow"
      }
    },
    "plan": {
      "permission": {
        "task": {
          "*": "allow"
        },
        "skill": {
          "*": "allow"
        },
        "edit": "deny",
        "bash": {
          "*": "deny"
        }
      }
    }
  }
}