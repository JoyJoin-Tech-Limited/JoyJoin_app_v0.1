{
  "$schema": "https://opencode.ai/config.json",
  "model": "kimi-for-coding/kimi-k2.7-code-highspeed",
  "provider": {
    "deepseek": {
      "models": {
        "deepseek-v4-flash": {
          "options": {
            "maxTokens": 16384
          },
          "variants": {
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "deepseek-v4-pro": {
          "options": {
            "maxTokens": 16384
          },
          "variants": {
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        }
      }
    },
    "kimi": {
      "models": {
        "kimi-k2.6": {
          "options": {
            "maxTokens": 16384
          },
          "variants": {
            "thinking": {
              "thinking": true
            }
          }
        }
      }
    },
    "kimi-for-coding": {
      "models": {
        "kimi-k2.7-code": {
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "options": {
            "maxTokens": 32768
          }
        },
        "kimi-k2.7-code-highspeed": {
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "options": {
            "maxTokens": 32768
          }
        }
      }
    },
    "glm": {
      "models": {
        "glm-5.1-fp8": {
          "options": {
            "maxTokens": 16384
          }
        },
        "glm-5-fp8": {
          "options": {
            "maxTokens": 16384
          }
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "postgres": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres"
      ],
      "args": [
        "{env:MCP_DATABASE_URL}"
      ]
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem"
      ],
      "args": [
        "{env:PWD}"
      ]
    }
  },
  "permission": {
    "*": "allow",
    "task": {
      "*": "allow"
    },
    "skill": {
      "*": "allow"
    }
  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "opencode-mem"
  ],
  "command": {
    "mentor": {
      "template": "Load the cto-mentor skill. Provide a structured mentor breakdown of the most recent implementation work: (1) What we did & why — high-level friendly summary, (2) Key ideas at play — 2-3 concepts with plain-language metaphors first, (3) Trade-offs we made — honest about what we gave up, (4) Where to go next — concrete study/practice/build suggestions. Tone: warm, encouraging, jargon-free. Max 3 concepts.",
      "description": "CTO Mentor — structured breakdown of completed work"
    }
  },
  "instructions": [
    ".opencode/rules/joyjoin-workflow.md",
    ".opencode/rules/joyjoin-orchestration.md",
    ".opencode/rules/joyjoin-harness.md"
  ],
  "agent": {
    "build": {
      "permission": {
        "task": {
          "*": "allow"
        },
        "skill": {
          "*": "allow"
        },
        "bash": {
          "*": "allow"
        },
        "edit": "allow",
        "webfetch": "allow"
      }
    },
    "plan": {
      "permission": {
        "task": {
          "*": "allow"
        },
        "skill": {
          "*": "allow"
        },
        "edit": "deny",
        "bash": {
          "*": "deny"
        }
      }
    }
  }
}