{
  "name": "@joyjoin/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx/esm src/index.ts",
    "build": "NODE_ENV=production esbuild ./src/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist --external:vite --external:nanoid --define:process.env.NODE_ENV=\\\"production\\\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "NODE_ENV=production node --import tsx/esm dist/index.js",
    "db:push": "node --env-file=../../.env ../../node_modules/drizzle-kit/bin.cjs push --config=./drizzle.config.cjs",
    "db:generate": "node --env-file=../../.env ../../node_modules/drizzle-kit/bin.cjs generate --config=./drizzle.config.cjs",
    "db:migrate": "node --env-file=../../.env ../../node_modules/drizzle-kit/bin.cjs migrate --config=./drizzle.config.cjs",
    "db:studio": "node --env-file=../../.env ../../node_modules/drizzle-kit/bin.cjs studio --config=./drizzle.config.cjs",
    "admin:create": "node --env-file=../../.env --import tsx/esm src/cli/createAdminAccount.ts",
    "user:create": "node --env-file=../../.env --import tsx/esm src/cli/createUserAccount.ts",
    "user:bypass": "node --env-file=../../.env --import tsx/esm src/cli/bypassLogin.ts",
    "seed:test-data": "node --env-file=../../.env --import tsx/esm src/scripts/seed-test-data.ts",
    "seed:mock-data": "node --env-file=../../.env --import tsx/esm src/scripts/generate-mock-data.ts",
    "benchmark:matching-stress": "tsx src/benchmarks/matchingStressSimulation.cli.ts"
  },
  "dependencies": {
    "@joyjoin/shared": "^1.0.0",
    "@napi-rs/canvas": "^1.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.1",
    "drizzle-zod": "^0.7.0",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "memoizee": "^0.4.17",
    "memorystore": "^1.6.7",
    "node-cache": "^5.1.2",
    "openai": "^6.34.0",
    "openid-client": "^6.8.2",
    "passport": "^0.7.0",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "qqwry-lite": "^0.2.1",
    "tsx": "^4.21.0",
    "ws": "^8.20.0",
    "zod": "^3.24.2",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie": "^0.6.0",
    "@types/cookie-signature": "^1.1.2",
    "@types/cors": "^2.8.19",
    "@types/express": "4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/memoizee": "^0.4.12",
    "@types/node": "20.16.11",
    "@types/passport": "^1.0.17",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.12",
    "typescript": "5.6.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.4"
  }
}
