    {
      "id": "dialogue_1",
      "type": "dialogue",
      "content": {
        "speaker": "阿浪",
        "body": "『你平时等人吗？』",
        "imageKey": "alang-found-scene-placeholder"
      },
      "choices": [
        {
          "label": "等过，但很少被人等",
          "response": "阿浪点点头：『我也是。所以今天我提前来了。』",
          "nextNodeId": "dialogue_2",
          "moodShift": "共鸣"
        },
        {
          "label": "不习惯等，习惯被等",
          "response": "阿浪笑了一下：『那今天我们换换位置。』",
          "nextNodeId": "dialogue_2",
          "moodShift": "轻松"
        },
        {
          "label": "我不等人，我找人",
          "response": "阿浪愣了一下，然后笑了：『那你找到了。』",
          "nextNodeId": "dialogue_2",
          "moodShift": "俏皮"
        }
      ]
    },
    {
      "id": "dialogue_2",
      "type": "dialogue",
      "content": {
        "speaker": "阿浪",
        "body": "『如果今天没有遇到我，你本来打算做什么？』",
        "imageKey": "alang-found-scene-placeholder"
      },
      "choices": [
        {
          "label": "沿着海边走一圈",
          "response": "『那现在有人陪你走了。』阿浪站起来，拍了拍裤子上的沙。",
          "nextNodeId": "dialogue_3",
          "moodShift": "温暖"
        },
        {
          "label": "找个地方坐着发呆",
          "response": "『那现在有人陪你发呆了。』阿浪没有动，但往旁边挪了挪，让出半个长椅。",
          "nextNodeId": "dialogue_3",
          "moodShift": "安静"
        },
        {
          "label": "本来没打算来",
          "response": "『那现在来了。』阿浪站起来，『走吧，既然来了。』",
          "nextNodeId": "dialogue_3",
          "moodShift": "随性"
        }
      ]
    },
    {
      "id": "dialogue_3",
      "type": "dialogue",
      "content": {
        "speaker": "阿浪",
        "body": "『你觉得，两个人一起走，和一个人走，最大的区别是什么？』",
        "imageKey": "alang-found-scene-placeholder"
      },
      "choices": [
        {
          "label": "有人可以说话",
          "response": "『说话很重要。』阿浪说，『但有时候，一起不说话也很好。』",
          "nextNodeId": "companion_start",
          "moodShift": "温和"
        },
        {
          "label": "节奏会变慢",
          "response": "『对。』阿浪说，『一个人走得快，两个人走得远。』",
          "nextNodeId": "companion_start",
          "moodShift": "深沉"
        },
        {
          "label": "没什么区别",
          "response": "阿浪看了你一眼，没说话，只是笑了笑。",
          "nextNodeId": "companion_start",
          "moodShift": "淡然"
        }
      ]
    },
