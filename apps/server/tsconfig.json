{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "../../packages/shared/src/*"
      ]
    },
    "types": [
      "node",
      "compression",
      "qrcode"
    ]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "dist"
  ]
}
