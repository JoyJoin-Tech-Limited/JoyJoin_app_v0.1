<view class="joy-custom-tab-bar {{lowEnd ? 'joy-custom-tab-bar--low-end' : ''}}" hidden="{{hidden}}">
  <!--
    IMPORTANT: Keep this native custom tab bar as plain <view>/<image>.
    Do NOT wrap children in <cover-view>/<cover-image>. WeChat's cover-view
    overlay only reliably renders cover-view/cover-image children; plain
    <view>/<image> inside a <cover-view> are dropped, causing blank tab icons
    and labels. See commit 0f3f8361c for the original fix and 2f9a71b3a for
    the accidental hybrid regression.
  -->
  <!-- Screen-reader announcement region (visually hidden, aria-live for tab switches) -->
  <view class="joy-custom-tab-bar__sr-announce" aria-live="polite" aria-atomic="true">
    {{announcement}}
  </view>
  <view class="joy-custom-tab-bar__surface">
    <!-- Background with semi-circular notch -->
    <image
      class="joy-custom-tab-bar__bg"
      src="../assets/tab-bar-notch-bg.png"
      mode="scaleToFill"
    />

    <!-- Tab row: left 2 + gap + right 2 -->
    <view class="joy-custom-tab-bar__row">
      <!-- Shared sliding active pill (moves between tabs) -->
      <view
        class="joy-custom-tab-bar__active-pill {{pillTransitionEnabled ? '' : 'joy-custom-tab-bar__active-pill--no-transition'}}"
        style="transform: translateX({{pillTranslateX}}rpx); width: {{pillWidth}}rpx; opacity: {{selected === 4 ? 0 : 1}};"
        aria-hidden="true"
      />

      <!-- Left side tabs -->
      <view class="joy-custom-tab-bar__side">
        <view
          wx:for="{{leftTabs}}"
          wx:key="key"
          class="joy-custom-tab-bar__item"
          data-index="{{item.index}}"
          data-url="{{item.url}}"
          data-tab="{{item.key}}"
          bindtap="handleTabTap"
          hover-class="joy-custom-tab-bar__item--pressed"
          hover-stay-time="150"
          role="button"
          aria-label="{{item.text}}"
          aria-pressed="{{selected === item.index}}"
        >
          <view class="joy-custom-tab-bar__item-icon-wrap">
            <image
              class="joy-custom-tab-bar__item-icon {{selected === item.index ? 'joy-custom-tab-bar__item-icon--active' : ''}}"
              src="{{selected === item.index ? item.selectedIcon : item.icon}}"
              mode="aspectFit"
              data-tab="{{item.key}}"
              data-src="{{selected === item.index ? item.selectedIcon : item.icon}}"
              binderror="handleIconError"
            />
            <view
              wx:if="{{item.badgeCount > 0}}"
              class="joy-custom-tab-bar__item-badge"
            >
              <view class="joy-custom-tab-bar__item-badge-text">
                {{item.badgeCount > 99 ? '99+' : item.badgeCount}}
              </view>
            </view>
          </view>
          <view
            class="joy-custom-tab-bar__item-label {{selected === item.index ? 'joy-custom-tab-bar__item-label--active' : ''}}"
          >
            {{item.text}}
          </view>
        </view>
      </view>

      <view class="joy-custom-tab-bar__center-gap"></view>

      <!-- Right side tabs -->
      <view class="joy-custom-tab-bar__side">
        <view
          wx:for="{{rightTabs}}"
          wx:key="key"
          class="joy-custom-tab-bar__item"
          data-index="{{item.index}}"
          data-url="{{item.url}}"
          data-tab="{{item.key}}"
          bindtap="handleTabTap"
          hover-class="joy-custom-tab-bar__item--pressed"
          hover-stay-time="150"
          role="button"
          aria-label="{{item.text}}"
          aria-pressed="{{selected === item.index}}"
        >
          <view class="joy-custom-tab-bar__item-icon-wrap">
            <image
              class="joy-custom-tab-bar__item-icon {{selected === item.index ? 'joy-custom-tab-bar__item-icon--active' : ''}}"
              src="{{selected === item.index ? item.selectedIcon : item.icon}}"
              mode="aspectFit"
              data-tab="{{item.key}}"
              data-src="{{selected === item.index ? item.selectedIcon : item.icon}}"
              binderror="handleIconError"
            />
            <view
              wx:if="{{item.badgeCount > 0}}"
              class="joy-custom-tab-bar__item-badge"
            >
              <view class="joy-custom-tab-bar__item-badge-text">
                {{item.badgeCount > 99 ? '99+' : item.badgeCount}}
              </view>
            </view>
          </view>
          <view
            class="joy-custom-tab-bar__item-label {{selected === item.index ? 'joy-custom-tab-bar__item-label--active' : ''}}"
          >
            {{item.text}}
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- Semi-raised center CTA -->
  <view class="joy-custom-tab-bar__center-wrap">
    <!-- selected === 4 is MINI_PROGRAM_TAB_INDEX.centerHub; keep in sync with tabBarConfig.ts -->
    <view
      class="joy-custom-tab-bar__center {{selected === 4 ? 'joy-custom-tab-bar__center--selected' : ''}}"
      bindtap="handleCenterTap"
      hover-class="joy-custom-tab-bar__center--pressed"
      hover-stay-time="150"
      role="button"
      aria-label="{{center.label || 'JoyJoin 中心入口'}}"
      aria-pressed="{{selected === 4}}"
    >
      <view class="joy-custom-tab-bar__center-outer-ring">
        <view class="joy-custom-tab-bar__center-button">
          <image
            class="joy-custom-tab-bar__center-logo"
            src="../assets/joyjoin-logo-tab.png"
            mode="aspectFit"
            data-tab="center"
            data-src="../assets/joyjoin-logo-tab.png"
            binderror="handleIconError"
          />
          <view wx:if="{{center.showBadge}}" class="joy-custom-tab-bar__center-badge"></view>
        </view>
      </view>
      <view class="joy-custom-tab-bar__center-label-pill">
        <view class="joy-custom-tab-bar__center-label">{{center.label}}</view>
      </view>
    </view>
  </view>
</view>
