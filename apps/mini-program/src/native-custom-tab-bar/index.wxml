<view wx:if="{{!hidden && !sheetOpen}}" class="joy-custom-tab-bar {{lowEnd ? 'joy-custom-tab-bar--low-end' : ''}}">
  <!-- Do NOT wrap children in <cover-view>/<cover-image>: cover-image has independent render layer quirks causing blank tab icons on some devices. -->
  <view class="joy-custom-tab-bar__surface">
    <!-- Background with semi-circular notch -->
    <image
      class="joy-custom-tab-bar__bg"
      src="../assets/tab-bar-notch-bg.png"
      mode="scaleToFill"
    />

    <!-- Tab row: left 2 + gap + right 2 -->
    <view class="joy-custom-tab-bar__row">
      <!-- Left side tabs -->
      <view class="joy-custom-tab-bar__side">
        <view
          wx:for="{{leftTabs}}"
          wx:key="key"
          class="joy-custom-tab-bar__item {{resolved && selected === item.index ? 'joy-custom-tab-bar__item--active' : ''}}"
          data-index="{{item.index}}"
          data-url="{{item.url}}"
          data-tab="{{item.key}}"
          bindtap="handleTabTap"
          hover-class="joy-custom-tab-bar__item--pressed"
          hover-start-time="0"
          hover-stay-time="100"
          role="button"
          aria-label="{{item.text}}"
          aria-pressed="{{resolved && selected === item.index}}"
        >
          <view class="joy-custom-tab-bar__item-icon-wrap">
            <!-- Single icon, src swapped on selection. The previous dual-icon
                 opacity crossfade left the selected tab showing the muted
                 artwork on real devices (the stacked, absolutely positioned
                 overlay never painted), so selection is expressed by the src
                 itself — the one thing the WeChat renderer has always honoured. -->
            <image
              class="joy-custom-tab-bar__item-icon"
              src="{{resolved && selected === item.index ? item.selectedIcon : item.icon}}"
              mode="aspectFit"
            />
            <view
              wx:if="{{item.badgeCount > 0}}"
              class="joy-custom-tab-bar__item-badge"
            >
              <view class="joy-custom-tab-bar__item-badge-text">
                {{item.badgeCount > 99 ? '99+' : item.badgeCount}}
              </view>
            </view>
            <!-- Dot indicator: boolean, never a count. wx:elif binds to the
                 number pill above, so a tab can never show both. -->
            <view
              wx:elif="{{item.badgeDot}}"
              class="joy-custom-tab-bar__item-dot"
            ></view>
          </view>
          <view
            class="joy-custom-tab-bar__item-label {{resolved && selected === item.index ? 'joy-custom-tab-bar__item-label--active' : ''}}"
          >
            {{item.text}}
          </view>
        </view>
      </view>

      <view class="joy-custom-tab-bar__center-gap"></view>

      <!-- Right side tabs -->
      <view class="joy-custom-tab-bar__side">
        <view
          wx:for="{{rightTabs}}"
          wx:key="key"
          class="joy-custom-tab-bar__item {{resolved && selected === item.index ? 'joy-custom-tab-bar__item--active' : ''}}"
          data-index="{{item.index}}"
          data-url="{{item.url}}"
          data-tab="{{item.key}}"
          bindtap="handleTabTap"
          hover-class="joy-custom-tab-bar__item--pressed"
          hover-start-time="0"
          hover-stay-time="100"
          role="button"
          aria-label="{{item.text}}"
          aria-pressed="{{resolved && selected === item.index}}"
        >
          <view class="joy-custom-tab-bar__item-icon-wrap">
            <image
              class="joy-custom-tab-bar__item-icon"
              src="{{resolved && selected === item.index ? item.selectedIcon : item.icon}}"
              mode="aspectFit"
            />
            <view
              wx:if="{{item.badgeCount > 0}}"
              class="joy-custom-tab-bar__item-badge"
            >
              <view class="joy-custom-tab-bar__item-badge-text">
                {{item.badgeCount > 99 ? '99+' : item.badgeCount}}
              </view>
            </view>
            <!-- Dot indicator: boolean, never a count. wx:elif binds to the
                 number pill above, so a tab can never show both. -->
            <view
              wx:elif="{{item.badgeDot}}"
              class="joy-custom-tab-bar__item-dot"
            ></view>
          </view>
          <view
            class="joy-custom-tab-bar__item-label {{resolved && selected === item.index ? 'joy-custom-tab-bar__item-label--active' : ''}}"
          >
            {{item.text}}
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- Semi-raised center CTA -->
  <view class="joy-custom-tab-bar__center-wrap">
    <view
      class="joy-custom-tab-bar__center {{resolved && selected === 4 ? 'joy-custom-tab-bar__center--selected' : ''}}"
      bindtap="handleCenterTap"
      hover-class="joy-custom-tab-bar__center--pressed"
      hover-start-time="0"
      hover-stay-time="100"
      role="button"
      aria-label="{{center.label || 'JoyJoin 中心入口'}}"
      aria-pressed="{{resolved && selected === 4}}"
    >
      <view class="joy-custom-tab-bar__center-outer-ring">
        <view class="joy-custom-tab-bar__center-button">
          <image
            class="joy-custom-tab-bar__center-logo {{settle ? 'joy-custom-tab-bar__center-logo--settle' : ''}}"
            src="../assets/joyjoin-logo-tab.png"
            mode="aspectFit"
          />
          <view wx:if="{{center.showBadge}}" class="joy-custom-tab-bar__center-badge"></view>
        </view>
      </view>
      <view class="joy-custom-tab-bar__center-label">{{center.label}}</view>
    </view>
  </view>

  <!-- Screen-reader switch confirmation. Visually hidden: this node is the
       consumer of `data.announcement` (see _setAnnouncement). Without it the
       announcement was written to state nobody ever rendered. -->
  <view class="joy-custom-tab-bar__a11y" aria-live="polite" aria-atomic="true">{{announcement}}</view>
</view>
