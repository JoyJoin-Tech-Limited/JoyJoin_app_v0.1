/* ─── JoyJoin Custom Tab Bar ─────────────────────────────────── */

.joy-custom-tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(120rpx + env(safe-area-inset-bottom));
  pointer-events: auto;
  z-index: 120;
}

.joy-custom-tab-bar__surface {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: env(safe-area-inset-bottom);
  height: 120rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(139, 92, 246, 0.06);
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.985);
  box-shadow: 0 14rpx 40rpx rgba(45, 49, 66, 0.1);
}

.joy-custom-tab-bar__border {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 0;
  height: 2rpx;
  background: rgba(139, 92, 246, 0.12);
  border-top-left-radius: 9999rpx;
  border-top-right-radius: 9999rpx;
}

/* ── Tab row ───────────────────────────────────────────────── */

.joy-custom-tab-bar__row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: stretch;
  height: 100%;
  box-sizing: border-box;
  padding: 8rpx 24rpx 6rpx;
}

.joy-custom-tab-bar__side {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: space-between;
}

.joy-custom-tab-bar__center-gap {
  width: 200rpx;
  flex-shrink: 0;
}

/* ── Tab item ──────────────────────────────────────────────── */

.joy-custom-tab-bar__item {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  min-width: 0;
  padding: 0 6rpx;
  box-sizing: border-box;
}

.joy-custom-tab-bar__item-icon-wrap {
  position: relative;
  display: flex;
  width: 56rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
}

.joy-custom-tab-bar__item-icon {
  width: 42rpx;
  height: 42rpx;
  opacity: 0.5;
}

.joy-custom-tab-bar__item-icon--active {
  opacity: 1;
}

.joy-custom-tab-bar__item-label {
  margin-top: 6rpx;
  max-width: 96rpx;
  font-size: 20rpx;
  line-height: 24rpx;
  color: #9CA3AF;
  text-align: center;
}

.joy-custom-tab-bar__item-label--active {
  color: #8B5CF6;
  font-weight: 600;
}

/* ── Side tab notification badge ───────────────────────────── */

.joy-custom-tab-bar__item-badge {
  position: absolute;
  top: -2rpx;
  right: -6rpx;
  z-index: 1;
  min-width: 34rpx;
  height: 34rpx;
  border-radius: 9999rpx;
  background: #FF6B9D;
  border: 4rpx solid rgba(255, 255, 255, 0.98);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.joy-custom-tab-bar__item-badge-text {
  font-size: 18rpx;
  line-height: 1;
  font-weight: 700;
  color: #FFFFFF;
  text-align: center;
}

/* ── Protruding center button ──────────────────────────────── */

.joy-custom-tab-bar__center {
  position: absolute;
  left: 50%;
  top: -64rpx;
  z-index: 2;
  display: flex;
  width: 200rpx;
  flex-direction: column;
  align-items: center;
  transform: translateX(-50%);
}

.joy-custom-tab-bar__center-outer-ring {
  position: relative;
  display: flex;
  height: 156rpx;
  width: 156rpx;
  align-items: center;
  justify-content: center;
  border-radius: 9999rpx;
  background: linear-gradient(135deg, rgba(255, 107, 157, 0.15) 0%, rgba(168, 107, 255, 0.15) 100%);
}

.joy-custom-tab-bar__center-button {
  position: relative;
  display: flex;
  height: 140rpx;
  width: 140rpx;
  align-items: center;
  justify-content: center;
  border-radius: 9999rpx;
  background: linear-gradient(135deg, #FF6B9D 0%, #A86BFF 100%);
  box-shadow:
    0 8rpx 24rpx rgba(139, 92, 246, 0.35),
    0 24rpx 56rpx rgba(255, 107, 157, 0.18);
  border: 6rpx solid rgba(255, 255, 255, 0.9);
}

.joy-custom-tab-bar__center-logo {
  width: 88rpx;
  height: 88rpx;
}

.joy-custom-tab-bar__center-badge {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 9999rpx;
  background: #FF6B9D;
  border: 4rpx solid #FFFFFF;
}

.joy-custom-tab-bar__center-label {
  margin-top: 8rpx;
  max-width: 192rpx;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 600;
  color: #2D3142;
  text-align: center;
}
