/* ─── JoyJoin Custom Tab Bar ─────────────────────────────────── */

.joy-custom-tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(128rpx + env(safe-area-inset-bottom));
  pointer-events: auto;
  z-index: 120;
}

.joy-custom-tab-bar__surface {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: env(safe-area-inset-bottom);
  height: 128rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(139, 92, 246, 0.06);
  border-radius: 42rpx;
  background: rgba(255, 255, 255, 0.985);
  box-shadow: 0 10rpx 28rpx rgba(45, 49, 66, 0.08);
}

.joy-custom-tab-bar__border {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 0;
  height: 2rpx;
  background: rgba(139, 92, 246, 0.12);
  border-top-left-radius: 9999rpx;
  border-top-right-radius: 9999rpx;
}

/* ── Tab row ───────────────────────────────────────────────── */

.joy-custom-tab-bar__row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: stretch;
  height: 100%;
  box-sizing: border-box;
  padding: 12rpx 24rpx 8rpx;
}

.joy-custom-tab-bar__side {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: space-between;
}

.joy-custom-tab-bar__center-gap {
  width: 192rpx;
  flex-shrink: 0;
}

.joy-custom-tab-bar__center-seat {
  position: absolute;
  left: 50%;
  top: 20rpx;
  z-index: 0;
  width: 184rpx;
  height: 88rpx;
  box-sizing: border-box;
  transform: translateX(-50%);
  border-radius: 42rpx;
  background: rgba(247, 243, 255, 0.88);
  border: 2rpx solid rgba(139, 92, 246, 0.08);
}

/* ── Tab item ──────────────────────────────────────────────── */

.joy-custom-tab-bar__item {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  min-width: 0;
  padding: 0 6rpx;
  box-sizing: border-box;
}

.joy-custom-tab-bar__item-icon-wrap {
  position: relative;
  display: flex;
  width: 56rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
}

.joy-custom-tab-bar__item-icon {
  width: 42rpx;
  height: 42rpx;
  opacity: 0.5;
}

.joy-custom-tab-bar__item-icon--active {
  opacity: 1;
}

.joy-custom-tab-bar__item-label {
  margin-top: 6rpx;
  max-width: 96rpx;
  font-size: 22rpx;
  line-height: 24rpx;
  color: #9CA3AF;
  text-align: center;
}

.joy-custom-tab-bar__item-label--active {
  color: #8B5CF6;
  font-weight: 600;
}

/* ── Side tab notification badge ───────────────────────────── */

.joy-custom-tab-bar__item-badge {
  position: absolute;
  top: -2rpx;
  right: -6rpx;
  z-index: 1;
  min-width: 34rpx;
  height: 34rpx;
  border-radius: 9999rpx;
  background: #FF6B9D;
  border: 4rpx solid rgba(255, 255, 255, 0.98);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.joy-custom-tab-bar__item-badge-text {
  font-size: 20rpx;
  line-height: 1;
  font-weight: 700;
  color: #FFFFFF;
  text-align: center;
}

/* ── Semi-raised center CTA ────────────────────────────────── */

.joy-custom-tab-bar__center {
  position: absolute;
  left: 50%;
  top: -42rpx;
  z-index: 2;
  display: flex;
  width: 192rpx;
  flex-direction: column;
  align-items: center;
  transform: translateX(-50%);
}

.joy-custom-tab-bar__center-outer-ring {
  position: relative;
  display: flex;
  height: 136rpx;
  width: 136rpx;
  align-items: center;
  justify-content: center;
  border-radius: 9999rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid rgba(139, 92, 246, 0.08);
}

.joy-custom-tab-bar__center-button {
  position: relative;
  display: flex;
  height: 122rpx;
  width: 122rpx;
  align-items: center;
  justify-content: center;
  border-radius: 9999rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #A16BFF 0%, #8B5CF6 100%);
  box-shadow:
    0 8rpx 18rpx rgba(45, 49, 66, 0.1),
    0 2rpx 8rpx rgba(139, 92, 246, 0.08);
  border: 4rpx solid rgba(255, 255, 255, 0.96);
}

.joy-custom-tab-bar__center-logo {
  width: 74rpx;
  height: 74rpx;
}

.joy-custom-tab-bar__center-badge {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 9999rpx;
  background: #FF6B9D;
  border: 3rpx solid rgba(255, 255, 255, 0.98);
}

.joy-custom-tab-bar__center-label {
  margin-top: 8rpx;
  max-width: 188rpx;
  font-size: 22rpx;
  line-height: 24rpx;
  font-weight: 600;
  color: #374151;
  text-align: center;
}
