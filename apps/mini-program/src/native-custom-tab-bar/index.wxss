/* ─── JoyJoin Custom Tab Bar ─────────────────────────────────── */

.joy-custom-tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(128rpx + env(safe-area-inset-bottom));
  pointer-events: auto;
  z-index: 120;
}

.joy-custom-tab-bar__surface {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(12rpx + env(safe-area-inset-bottom));
  height: 128rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.985);
  box-shadow: 0 16rpx 40rpx rgba(45, 49, 66, 0.12);
  border-radius: 40rpx;
}

.joy-custom-tab-bar__bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* ── Tab row ───────────────────────────────────────────────── */

.joy-custom-tab-bar__row {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: stretch;
  height: 100%;
  box-sizing: border-box;
  padding: 12rpx 24rpx 8rpx;
}

.joy-custom-tab-bar__side {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: space-between;
}

.joy-custom-tab-bar__center-gap {
  width: 192rpx;
  flex-shrink: 0;
}

/* ── Tab item ──────────────────────────────────────────────── */

.joy-custom-tab-bar__item {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  min-width: 0;
  padding: 0 6rpx;
  box-sizing: border-box;
}

.joy-custom-tab-bar__item-icon-wrap {
  position: relative;
  display: flex;
  width: 48rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
}

.joy-custom-tab-bar__item-icon {
  width: 42rpx;
  height: 42rpx;
  opacity: 0.5;
}

.joy-custom-tab-bar__item-icon--active {
  opacity: 1;
}

.joy-custom-tab-bar__item-label {
  margin-top: 6rpx;
  max-width: 96rpx;
  font-size: 22rpx;
  line-height: 24rpx;
  color: #9CA3AF;
  text-align: center;
}

.joy-custom-tab-bar__item-label--active {
  color: #8B5CF6;
  font-weight: 600;
}

/* Pressed / hover state for tab items */
.joy-custom-tab-bar__item--pressed {
  transform: scale(0.95);
  opacity: 0.8;
  transition: transform 100ms ease-out, opacity 100ms ease-out;
}

/* ── Side tab notification badge ───────────────────────────── */

.joy-custom-tab-bar__item-badge {
  position: absolute;
  top: -2rpx;
  right: -6rpx;
  z-index: 1;
  min-width: 34rpx;
  height: 34rpx;
  border-radius: 9999rpx;
  background: #FF6B9D;
  border: 4rpx solid rgba(255, 255, 255, 0.98);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.joy-custom-tab-bar__item-badge-text {
  font-size: 20rpx;
  line-height: 1;
  font-weight: 700;
  color: #FFFFFF;
  text-align: center;
}

/* ── Semi-raised center CTA ────────────────────────────────── */

.joy-custom-tab-bar__center {
  position: absolute;
  left: 50%;
  top: -42rpx;
  z-index: 3;
  display: flex;
  width: 192rpx;
  flex-direction: column;
  align-items: center;
  transform: translateX(-50%);
}

.joy-custom-tab-bar__center-outer-ring {
  position: relative;
  display: flex;
  height: 136rpx;
  width: 136rpx;
  align-items: center;
  justify-content: center;
  border-radius: 9999rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid rgba(139, 92, 246, 0.14);
}

.joy-custom-tab-bar__center-button {
  position: relative;
  display: flex;
  height: 122rpx;
  width: 122rpx;
  align-items: center;
  justify-content: center;
  border-radius: 9999rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #A16BFF 0%, #8B5CF6 100%);
  box-shadow:
    0 8rpx 18rpx rgba(45, 49, 66, 0.1),
    0 2rpx 8rpx rgba(139, 92, 246, 0.08);
  border: 4rpx solid rgba(255, 255, 255, 0.96);
}

.joy-custom-tab-bar__center-logo {
  width: 74rpx;
  height: 74rpx;
}

.joy-custom-tab-bar__center-badge {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 9999rpx;
  background: #FF6B9D;
  border: 3rpx solid rgba(255, 255, 255, 0.98);
}

.joy-custom-tab-bar__center-label {
  margin-top: 8rpx;
  max-width: 188rpx;
  font-size: 22rpx;
  line-height: 24rpx;
  font-weight: 600;
  color: #374151;
  text-align: center;
}

/* Pressed / hover state for center button */
.joy-custom-tab-bar__center--pressed {
  transform: translateX(-50%) scale(0.95);
  opacity: 0.9;
  transition: transform 100ms ease-out, opacity 100ms ease-out;
}

.joy-custom-tab-bar__center--selected .joy-custom-tab-bar__center-outer-ring {
  background: rgba(139, 92, 246, 0.12);
  border-color: rgba(139, 92, 246, 0.2);
}

.joy-custom-tab-bar__center--selected .joy-custom-tab-bar__center-label {
  color: #8B5CF6;
}
