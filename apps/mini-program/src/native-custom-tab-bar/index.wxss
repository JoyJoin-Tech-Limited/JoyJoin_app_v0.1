/* ─── JoyJoin Custom Tab Bar ─────────────────────────────────── */

/*
  Design tokens — kept in sync with apps/mini-program/src/styles/_variables.scss.
  These are duplicated here because the native custom tab bar is copied as-is
  to dist/custom-tab-bar/ and is not processed by Sass.

  Token map:
    --jj-primary        = $color-primary        #8B5CF6
    --jj-primary-text   = $color-primary-dark   #7C3AED  (active label, WCAG safe)
    --jj-secondary      = $color-secondary      #FF6B9D  (accents / outer ring)
    --jj-badge-bg       = brand primary at 82%  rgba(139, 92, 246, 0.82)  (notification badge fill)
    --jj-bg-tint-pink   = $color-bg-tint-pink   #FFF4F8
    --jj-text-inactive  = $color-text-secondary #6B7280  (WCAG 4.6:1 on white)
    --jj-text-dark      = $color-text-primary   #2D3142
    --jj-surface        = $color-surface        #FFFFFF
    --jj-shadow-*       = derived from $color-text-primary

  WXSS custom properties work in WeChat >= 8.0.0 (baseline: 8.0.16, Aug 2022).
*/
.joy-custom-tab-bar {
  --jj-primary: #8B5CF6;
  --jj-primary-text: #7C3AED;
  --jj-secondary: #FF6B9D;
  --jj-badge-bg: rgba(139, 92, 246, 0.82);
  --jj-bg-tint-pink: #FFF4F8;
  --jj-text-inactive: #6B7280;
  --jj-text-dark: #2D3142;
  --jj-surface: #FFFFFF;
  --jj-shadow-sm: rgba(45, 49, 66, 0.06);
  --jj-shadow-md: rgba(45, 49, 66, 0.1);
  --jj-shadow-lg: rgba(45, 49, 66, 0.14);
}

.joy-custom-tab-bar {
  position: fixed;
  /* Prevent repaint on scroll — tab bar is fixed, GPU layer hint */
  will-change: transform;
  transform: translateZ(0);
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(182rpx + env(safe-area-inset-bottom));
  pointer-events: auto;
  z-index: 120;
}

/* Visually hidden aria-live region for screen-reader announcements.
   Kept in layout (not display:none) so screen readers can access it. */
.joy-custom-tab-bar__sr-announce {
  position: absolute;
  width: 1rpx;
  height: 1rpx;
  padding: 0;
  margin: -1rpx;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.joy-custom-tab-bar__surface {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  height: 128rpx;
  box-sizing: border-box;
  background: var(--jj-surface);
  box-shadow: 0 -4rpx 24rpx var(--jj-shadow-sm),
              0 16rpx 48rpx var(--jj-shadow-lg);
  border-radius: 40rpx;
  border: 1rpx solid rgba(139, 92, 246, 0.06);
  overflow: hidden;
  z-index: 1;
  /* GPU-composite the pill surface — collapse scales from bottom so the
     surface shrinks into the safe area rather than pulling away from it. */
  will-change: transform;
  transform: translateZ(0);
  transform-origin: center bottom;
  transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
}

.joy-custom-tab-bar__bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* ── Tab row ───────────────────────────────────────────────── */

.joy-custom-tab-bar__row {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: stretch;
  height: 100%;
  box-sizing: border-box;
  padding: 8rpx 24rpx 8rpx;
}

.joy-custom-tab-bar__side {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: space-between;
}

.joy-custom-tab-bar__center-gap {
  width: 192rpx;
  flex-shrink: 0;
}

/* ── Tab item ──────────────────────────────────────────────── */

.joy-custom-tab-bar__item {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 0 8rpx;
  box-sizing: border-box;
  transition: transform 120ms cubic-bezier(0.22, 1, 0.36, 1), opacity 100ms ease-out, background-color 180ms ease;
  will-change: transform, opacity;
}

/* ── Shared sliding active pill ─────────────────────────────── */

.joy-custom-tab-bar__active-pill {
  display: none;
}

.joy-custom-tab-bar__item--active {
  background: rgba(139, 92, 246, 0.08);
  border-radius: 24rpx;
}

/* Interruptible transition: applied temporarily during rapid back-and-forth
   taps so the pill snaps to the latest tab instead of sweeping across the
   bar. The class is removed after the next setData. */
.joy-custom-tab-bar__active-pill--no-transition {
  transition: none !important;
}

.joy-custom-tab-bar__item-icon-wrap {
  position: relative;
  display: flex;
  width: 48rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
  transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
}

.joy-custom-tab-bar__item-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.5;
  transition: opacity 150ms ease;
  will-change: opacity;
}

.joy-custom-tab-bar__item-icon--active {
  opacity: 1;
}

.joy-custom-tab-bar__item-label {
  margin-top: 8rpx;
  max-width: 96rpx;
  font-size: 22rpx;
  line-height: 30rpx;
  color: var(--jj-text-inactive);
  text-align: center;
  /* Cascade delay: labels fade after the surface starts moving, creating a
     crafted staging effect on expand. Surface (0ms) → labels (30ms) → center pill (60ms). */
  transition: color 150ms ease, opacity 220ms ease 30ms;
}

.joy-custom-tab-bar__item-label--active {
  color: var(--jj-primary-text);
  font-weight: 600;
}

/* Pressed / hover state for tab items */
.joy-custom-tab-bar__item--pressed {
  transform: scale(0.95);
  opacity: 0.8;
}

/* ── Side tab notification badge ───────────────────────────── */

.joy-custom-tab-bar__item-badge {
  position: absolute;
  top: 0;
  right: -8rpx;
  z-index: 1;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 9999rpx;
  background: var(--jj-badge-bg);
  border: 2rpx solid rgba(139, 92, 246, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  box-sizing: border-box;
  animation: badge-pop-in 200ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

@keyframes badge-pop-in {
  0% { transform: scale(0); opacity: 0; }
  70% { transform: scale(1.15); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

.joy-custom-tab-bar__item-badge-text {
  font-size: 20rpx;
  line-height: 1;
  font-weight: 700;
  color: var(--jj-surface);
  text-align: center;
}

/* ── Semi-raised center CTA ────────────────────────────────── */

/* Logo settle-in (one-time on first render, transform-only, opacity-safe).
   Local assets load instantly, so this is a subtle scale settle rather than
   a fade-in. Settle expands 0.94→1.0 in 400ms.
   Gated by prefers-reduced-motion + .joy-custom-tab-bar--low-end below. */
.joy-custom-tab-bar__center-logo {
  /* Enlarged ~20% from the original 114rpx for a more impactful logo/tap target.
     142rpx leaves the same 4rpx breathing room inside the 150rpx inner button. */
  width: 142rpx;
  height: 142rpx;
  transform-origin: 50% 60%;
  animation: logo-settle 400ms cubic-bezier(0.22, 1, 0.36, 1) 1 both;
}

@keyframes logo-settle {
  0%   { transform: scale(0.94); }
  100% { transform: scale(1.0); }
}

/* Flexbox wrapper replaces the fragile left:50% + translateX(-50%)
   pattern which shifts right during WeChat renderer re-renders. */
.joy-custom-tab-bar__center-wrap {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  z-index: 3;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  pointer-events: none;
}

.joy-custom-tab-bar__center {
  display: flex;
  width: 148rpx;
  flex-direction: column;
  align-items: center;
  pointer-events: auto;
  /* Raise the center unit so the circle's horizontal midline (the left/right
     radius points) sits flush with the top edge of the tab-bar surface.
     Surface top is 38rpx from the root top (182 - 16 - 128); for a 164rpx
     outer ring the required offset is 38 - 82 = -44rpx. */
  margin-top: -44rpx;
  transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1), opacity 100ms ease-out;
  will-change: transform, opacity;
}

.joy-custom-tab-bar__center-outer-ring {
  position: relative;
  display: flex;
  /* Enlarged ~20% from 136rpx for a stronger center CTA presence. */
  height: 164rpx;
  width: 164rpx;
  align-items: center;
  justify-content: center;
  border-radius: 9999rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.96);
  border: 2rpx solid rgba(255, 107, 157, 0.18);
  transition: background-color 150ms ease, border-color 150ms ease;
  will-change: background-color, border-color;
  /* Keep the circle visually in front of the label pill so the pill appears
     to emerge from behind it, creating one integrated center CTA shape. */
  z-index: 2;
}

.joy-custom-tab-bar__center-button {
  position: relative;
  display: flex;
  /* Scaled with the outer ring to keep the same 7rpx gap on each side. */
  height: 150rpx;
  width: 150rpx;
  align-items: center;
  justify-content: center;
  border-radius: 9999rpx;
  box-sizing: border-box;
  /* Token: $color-bg-tint-pink — light pink so the multi-color JoyJoin logo pops
     against the background instead of clashing with the primary purple. */
  background: var(--jj-bg-tint-pink);
  box-shadow:
    0 8rpx 18rpx var(--jj-shadow-md),
    0 2rpx 8rpx rgba(255, 107, 157, 0.12);
  border: 4rpx solid rgba(255, 255, 255, 0.96);
  transition: box-shadow 240ms cubic-bezier(0.22, 1, 0.36, 1);
  will-change: box-shadow;
}

.joy-custom-tab-bar__center-badge {
  position: absolute;
  /* Scaled with the larger button to keep the badge near the top-right corner. */
  top: 10rpx;
  right: 10rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 9999rpx;
  background: var(--jj-badge-bg);
  border: 2rpx solid rgba(139, 92, 246, 0.12);
  animation: pulse-dot 3s ease-in-out infinite;
}

@keyframes pulse-dot {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.1); opacity: 0.92; }
}

.joy-custom-tab-bar__center-label-pill {
  position: relative;
  z-index: 1;
  /* Gap below the circle instead of overlapping; keeps pill anchored visually. */
  margin-top: 4rpx;
  padding: 6rpx 18rpx;
  min-width: 72rpx;
  max-width: 148rpx;
  border-radius: 16rpx;
  background: var(--jj-bg-tint-pink);
  border: 2rpx solid rgba(255, 255, 255, 0.96);
  box-shadow: 0 4rpx 12rpx var(--jj-shadow-sm);
  box-sizing: border-box;
  text-align: center;
  /* Cascade delay: center pill appears last in the expand cascade. */
  transition: opacity 220ms ease 60ms;
}

.joy-custom-tab-bar__center-label {
  max-width: 112rpx;
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 600;
  color: var(--jj-text-dark);
  text-align: center;
  transition: color 150ms ease;
}

/* Pressed / hover state for center button */
.joy-custom-tab-bar__center--pressed {
  transform: scale(0.95);
  opacity: 0.85;
}

.joy-custom-tab-bar__center--selected .joy-custom-tab-bar__center-outer-ring {
  background: rgba(255, 107, 157, 0.08);
  border-color: rgba(255, 107, 157, 0.15);
}

.joy-custom-tab-bar__center--selected .joy-custom-tab-bar__center-label {
  color: var(--jj-primary-text);
}

/* Active-state glow on the center button ("you are here" signal).
   Static, not animated — a 4rpx pink ring + 18rpx pink halo sit
   inside the 5rpx gap between the 150rpx inner button and the 164rpx
   outer ring, so the white outer ring stays visible. Box-shadow
   transition 240ms keeps the selection feel responsive without being
   attention-grabbing. */
.joy-custom-tab-bar__center--selected .joy-custom-tab-bar__center-button {
  box-shadow:
    0 0 0 4rpx rgba(255, 107, 157, 0.22),
    0 0 18rpx rgba(255, 107, 157, 0.28),
    0 8rpx 18rpx rgba(45, 49, 66, 0.1),
    0 2rpx 8rpx rgba(255, 107, 157, 0.08);
}

/* Cover-image fade-in removed: local assets load instantly and the global
   animation caused re-render flicker every time setData fired. */

/* ── Discover-only scroll-responsive collapse ───────────────────── */

.joy-custom-tab-bar--collapsed .joy-custom-tab-bar__surface {
  /* 128rpx → 88rpx (0.6875×) — hits the 88rpx minimum touch target. */
  transform: translateZ(0) scaleY(0.6875);
}

/* Counter-scale icon wraps so icons stay visually 40rpx when the surface
   is collapsed. net: 0.6875 × 1.4545 ≈ 1.0. */
.joy-custom-tab-bar--collapsed .joy-custom-tab-bar__item-icon-wrap {
  transform: scaleY(1.4545);
  transform-origin: center center;
}

.joy-custom-tab-bar--collapsed .joy-custom-tab-bar__center {
  /* Center CTA tracks the surface top: 128 → 88rpx = 40rpx shift down. */
  transform: translateY(40rpx);
}

.joy-custom-tab-bar--collapsed .joy-custom-tab-bar__item-label {
  opacity: 0;
}

.joy-custom-tab-bar--collapsed .joy-custom-tab-bar__center-label-pill {
  opacity: 0;
}

/* Badges distort under the icon-wrap counter-scale; hide them in
   collapsed state since the compact surface has no room for them. */
.joy-custom-tab-bar--collapsed .joy-custom-tab-bar__item-badge {
  opacity: 0;
  pointer-events: none;
  transition: opacity 220ms ease;
}

.joy-custom-tab-bar--collapsed .joy-custom-tab-bar__item--active {
  background-color: transparent;
}

/* Low-end device (benchmarkLevel <= 15): disable all animations */
.joy-custom-tab-bar--low-end .joy-custom-tab-bar__surface,
.joy-custom-tab-bar--low-end .joy-custom-tab-bar__item,
.joy-custom-tab-bar--low-end .joy-custom-tab-bar__active-pill,
.joy-custom-tab-bar--low-end .joy-custom-tab-bar__center {
  transition: none !important;
  will-change: auto !important;
  animation: none !important;
  transform: none !important;
}
.joy-custom-tab-bar--low-end .joy-custom-tab-bar__item--pressed,
.joy-custom-tab-bar--low-end .joy-custom-tab-bar__center--pressed {
  transform: none !important;
  opacity: 1 !important;
}
.joy-custom-tab-bar--low-end .joy-custom-tab-bar__item-icon {
  transition: none !important;
  will-change: auto !important;
}
.joy-custom-tab-bar--low-end .joy-custom-tab-bar__item-label {
  transition: none !important;
}
.joy-custom-tab-bar--low-end .joy-custom-tab-bar__item-badge {
  animation: none !important;
  transform: scale(1);
  opacity: 1;
}
.joy-custom-tab-bar--low-end .joy-custom-tab-bar__center-badge {
  animation: none !important;
}
.joy-custom-tab-bar--low-end image {
  animation: none !important;
  opacity: 1 !important;
}
.joy-custom-tab-bar--low-end .joy-custom-tab-bar__center-logo {
  animation: none !important;
  transform: none !important;
}
.joy-custom-tab-bar--low-end .joy-custom-tab-bar__center-button {
  transition: none !important;
  will-change: auto !important;
}
/* Defensive: if collapsed state leaks past the JS gate on low-end devices,
   force all collapse transforms back to neutral. */
.joy-custom-tab-bar--low-end .joy-custom-tab-bar--collapsed .joy-custom-tab-bar__surface,
.joy-custom-tab-bar--low-end .joy-custom-tab-bar--collapsed .joy-custom-tab-bar__center,
.joy-custom-tab-bar--low-end .joy-custom-tab-bar--collapsed .joy-custom-tab-bar__item-icon-wrap {
  transform: none !important;
}

/* Reduced motion: disable all animations, reset transform to avoid
   unnecessary GPU compositor layers when collapse is disabled. */
@media (prefers-reduced-motion: reduce) {
  .joy-custom-tab-bar__surface,
  .joy-custom-tab-bar__item,
  .joy-custom-tab-bar__active-pill,
  .joy-custom-tab-bar__center {
    transition: none !important;
    will-change: auto !important;
    animation: none !important;
    transform: none !important;
  }
  .joy-custom-tab-bar__item--pressed,
  .joy-custom-tab-bar__center--pressed {
    transform: none !important;
    opacity: 1 !important;
  }
  .joy-custom-tab-bar__item-icon {
    transition: none !important;
    will-change: auto !important;
  }
  .joy-custom-tab-bar__item-label {
    transition: none !important;
  }
  .joy-custom-tab-bar__item-badge {
    animation: none !important;
    transform: scale(1);
    opacity: 1;
  }
  .joy-custom-tab-bar__center-badge {
    animation: none !important;
  }
  .joy-custom-tab-bar__center-logo {
    animation: none !important;
    transform: none !important;
  }
  .joy-custom-tab-bar__center-button {
    transition: none !important;
    will-change: auto !important;
  }
  /* Counter-scale icons must not squash under reduced motion. */
  .joy-custom-tab-bar--collapsed .joy-custom-tab-bar__item-icon-wrap {
    transform: none !important;
  }
  /* Defensive: if collapsed state somehow leaks past the JS gate, force expand. */
  .joy-custom-tab-bar--collapsed .joy-custom-tab-bar__surface {
    transform: none !important;
  }
  .joy-custom-tab-bar--collapsed .joy-custom-tab-bar__center {
    transform: none !important;
  }
  .joy-custom-tab-bar image {
    animation: none !important;
    opacity: 1 !important;
  }
}
